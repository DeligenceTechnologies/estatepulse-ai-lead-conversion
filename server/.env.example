# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL must be the POOLED connection (Supavisor, port 6543, transaction
# mode). The pgbouncer=true flag tells Prisma to disable prepared statements,
# which transaction pooling cannot support.
#
# Keep connection_limit low: every app instance multiplies it, and Supabase
# pooler seats are finite.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# DIRECT_URL is the DIRECT connection (port 5432). Used ONLY by `prisma migrate`
# — migrations need session-level features the pooler does not provide.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Encryption — lead source signing secrets and ingest tokens
# ---------------------------------------------------------------------------
# JSON map of keyId -> base64(32 random bytes). Ciphertexts embed the keyId they
# were written with, so rotation means adding a new key and flipping
# ENCRYPTION_ACTIVE_KEY_ID; old ciphertexts keep decrypting.
#
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS='{"k1":"REPLACE_WITH_BASE64_32_BYTES"}'
ENCRYPTION_ACTIVE_KEY_ID="k1"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Public origin used to BUILD the webhook URLs we show customers. Must be the
# externally reachable host — for local Tally testing this is your ngrok URL,
# e.g. https://abc123.ngrok-free.app
PUBLIC_API_BASE_URL="http://localhost:3001"

# Comma-separated origins allowed to call the /v1 dashboard API.
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Run the async processing loop in this process. Set false on instances that
# should only serve HTTP.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
# Requeue rows left PROCESSING by a killed worker after this long.
WORKER_STUCK_AFTER_MS=300000

# ---------------------------------------------------------------------------
# Ingest limits
# ---------------------------------------------------------------------------
INGEST_MAX_BODY_BYTES=1048576
INGEST_RATE_LIMIT_PER_MIN=60
INGEST_RATE_LIMIT_BURST=120
# Bounded quarantine storage for signature failures: enough for a customer to
# fully recover from a wrong secret, capped so it is not a storage-exhaustion
# vector for an attacker.
QUARANTINE_MAX_PER_HOUR=20
QUARANTINE_MAX_PER_SOURCE=200
