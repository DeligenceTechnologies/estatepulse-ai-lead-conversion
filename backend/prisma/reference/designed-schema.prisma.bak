// EstatePulse AI — lead ingestion schema
//
// Conventions that are load-bearing (do not "simplify" these away):
//
//  * Every timestamp is @db.Timestamptz(6). Prisma's default DateTime maps to
//    timestamp(3) WITHOUT time zone, which is a bug factory for a product whose
//    promises are "respond within 30 seconds" and "quiet hours in the lead's
//    local time".
//  * Primary keys are app-generated UUIDv7 (see src/common/ids.ts), not
//    gen_random_uuid(). v7 is time-ordered so inserts stay in the right-hand
//    index pages (webhook_events is the highest-insert-rate table here), and we
//    need the id BEFORE the insert to compute encryption AAD and identity keys.
//  * Enum values @map to the exact lowercase strings used by the SPA's
//    string-literal unions in src/types.ts, so the frontend types stay valid
//    with no translation layer.
//  * Partial and unique-partial indexes live in raw SQL in the migration —
//    Prisma cannot express a WHERE clause on an index. See
//    prisma/migrations/*/partial_indexes.sql.
//
// Supabase/Supavisor constraints:
//  * DATABASE_URL is the pooled port (6543, transaction mode) with
//    ?pgbouncer=true&connection_limit=5. DIRECT_URL (5432) is migrations only.
//  * pg_advisory_lock (session-scoped) is FORBIDDEN under transaction pooling:
//    the connection returns to the pool still holding the lock and the next
//    tenant's query inherits it. Only pg_advisory_xact_lock is safe.
//  * LISTEN/NOTIFY does not survive transaction pooling either — the queue is
//    designed to poll rather than depend on it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
//
// Caveat: ALTER TYPE ... ADD VALUE cannot be used in the same transaction that
// uses the new value, and Prisma wraps each migration in a transaction. Adding
// an enum value AND backfilling with it in one migration will fail — split it
// into two. Sets we expect to churn (transform kinds, Tally field types) are
// deliberately String, not enum, for exactly this reason.
// ---------------------------------------------------------------------------

/// Mirrors LeadStatus in src/types.ts
enum LeadStatus {
  NEW                @map("new")
  CONTACTED          @map("contacted")
  ENGAGED            @map("engaged")
  QUALIFIED          @map("qualified")
  APPOINTMENT_BOOKED @map("appointment_booked")
  NURTURE            @map("nurture")
  HUMAN_HANDOFF      @map("human_handoff")
  CLOSED             @map("closed")
  DNC                @map("dnc")
  LOST               @map("lost")

  @@map("lead_status")
}

/// Mirrors LeadTemperature in src/types.ts
enum LeadTemperature {
  HOT  @map("hot")
  WARM @map("warm")
  COLD @map("cold")

  @@map("lead_temperature")
}

enum LeadType {
  BUYER  @map("buyer")
  SELLER @map("seller")

  @@map("lead_type")
}

/// Mirrors Lead.consentStatus in src/types.ts.
/// REVOKED is terminal with respect to the ingestion path — see the merge
/// policy in src/modules/processing/merge/. A public form can never undo it.
enum ConsentStatus {
  GRANTED @map("granted")
  REVOKED @map("revoked")
  PENDING @map("pending")

  @@map("consent_status")
}

enum AgentRole {
  OWNER @map("owner")
  ADMIN @map("admin")
  AGENT @map("agent")

  @@map("agent_role")
}

enum AgentStatus {
  AVAILABLE @map("available")
  IN_CALL   @map("in_call")
  BUSY      @map("busy")
  OFFLINE   @map("offline")

  @@map("agent_status")
}

enum SourceProvider {
  TALLY
  GENERIC_JSON
  META_LEAD_ADS
  ZILLOW
  ZAPIER
  MANUAL

  @@map("source_provider")
}

enum SourceStatus {
  DRAFT
  AWAITING_FIRST_EVENT
  NEEDS_MAPPING
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("source_status")
}

enum MappingStatus {
  UNCONFIGURED
  NEEDS_REVIEW
  CONFIGURED

  @@map("mapping_status")
}

enum FieldStatus {
  NEW
  ACTIVE
  MISSING

  @@map("field_status")
}

enum MappingOrigin {
  HEURISTIC
  USER
  IMPORTED

  @@map("mapping_origin")
}

/// Queue mechanics. Deliberately SEPARATE from DeliveryOutcome: merging them
/// means every new business outcome risks silently changing the poller's
/// partial-index predicate. queueState drives the worker; outcome drives the UI.
enum QueueState {
  PENDING
  PROCESSING
  DONE
  FAILED
  DEAD_LETTER

  @@map("queue_state")
}

/// Business result of a delivery, as rendered in the Deliveries UI.
enum DeliveryOutcome {
  PROCESSED
  PROCESSED_WITH_WARNINGS
  DUPLICATE
  /// Stored and replayable; mapping was incomplete so no lead was created.
  NEEDS_MAPPING
  /// Mapped, but yielded neither a usable phone nor email.
  NEEDS_IDENTITY
  /// HMAC failed. Raw body retained; never processed until the secret is fixed.
  QUARANTINED_SIGNATURE
  INVALID_PAYLOAD
  ERROR

  @@map("delivery_outcome")
}

enum SignatureState {
  VALID
  INVALID
  MISSING
  NOT_CONFIGURED

  @@map("signature_state")
}

/// Mirrors AuditLog.actor in src/types.ts
enum ActorType {
  SYSTEM
  WEBHOOK
  AI
  USER
  API_KEY

  @@map("actor_type")
}

// ---------------------------------------------------------------------------
// Tenancy root
// ---------------------------------------------------------------------------

model Organization {
  id            String    @id @db.Uuid
  slug          String    @unique
  name          String
  timezone      String    @default("America/Chicago")
  /// libphonenumber default region for parsing bare national numbers to E.164.
  defaultRegion String    @default("US") @map("default_region")
  /// OrganizationSettings blob from src/types.ts (aiTone, businessHours, …)
  settings      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  apiKeys       ApiKey[]
  agents        Agent[]
  leadSources   LeadSource[]
  leads         Lead[]
  webhookEvents WebhookEvent[]
  submissions   LeadSubmission[]
  auditLogs     AuditLog[]
  domainEvents  DomainEvent[]

  @@map("organizations")
}

/// Dashboard/API credential. Deliberately a DIFFERENT credential from a lead
/// source's ingest token: an ingest token is pasted into a third party's UI and
/// lives in their logs, while an API key can read the whole tenant. Rotating
/// one must never break the other.
///
/// Hashing (not encrypting) is correct here — we only ever verify a presented
/// key, never reproduce it. Unsalted SHA-256 is right because the key is 160+
/// bits of CSPRNG entropy: there is no dictionary to attack, and bcrypt would
/// just add ~100ms to every request.
model ApiKey {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyHash        String    @unique @map("key_hash")
  /// e.g. "ep_live_a1b2c3" — display and support triage only, never secret.
  keyPrefix      String    @map("key_prefix")
  scopes         String[]  @default([])
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}

model Agent {
  id              String      @id @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  name            String
  email           String
  phone           String?
  phoneE164       String?     @map("phone_e164")
  avatarUrl       String?     @map("avatar_url")
  calendarUrl     String?     @map("calendar_url")
  workingHours    String?     @map("working_hours")
  timezone        String      @default("America/Chicago")
  role            AgentRole   @default(AGENT)
  status          AgentStatus @default(OFFLINE)
  isActive        Boolean     @default(true) @map("is_active")
  /// Denormalized counter driving least-loaded routing. We deliberately do NOT
  /// use a round-robin cursor: that is a single hot row every ingest must
  /// UPDATE, which serializes the pipeline exactly when Tally redelivers a
  /// burst. Least-loaded is stateless and self-heals when an agent goes offline.
  activeLeadCount Int         @default(0) @map("active_lead_count")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id])
  leads           Lead[]

  @@unique([organizationId, email])
  /// Serves the routing query: WHERE org=? AND is_active ORDER BY active_lead_count LIMIT 1
  @@index([organizationId, isActive, activeLeadCount])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// Lead sources — a connected form/provider
// ---------------------------------------------------------------------------

model LeadSource {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  provider       SourceProvider @default(TALLY)
  status         SourceStatus   @default(AWAITING_FIRST_EVENT)

  // --- Ingest token: two columns, two jobs. ---
  //
  // ingestTokenHash is the ONLY lookup path: one equality probe on an indexed
  // column, no scan, no decryption on the hot path. Storing the token in
  // plaintext would mean a leaked backup lets an attacker inject fabricated
  // leads into every tenant — which from M2 onward means real outbound SMS and
  // voice spend plus TCPA exposure, not merely junk rows.
  //
  // ingestTokenEnc exists because re-displayability is a hard product
  // requirement here (unlike an API key): the customer comes back next week to
  // paste the URL into a second form. A show-once-then-hash design would force
  // a rotation every time, silently breaking whatever form still points at the
  // old URL. Decrypting for display is an audited admin-only read path.
  ingestTokenHash    String    @unique @map("ingest_token_hash")
  ingestTokenPrefix  String    @map("ingest_token_prefix")
  ingestTokenEnc     String    @map("ingest_token_enc")
  tokenRotatedAt     DateTime? @map("token_rotated_at") @db.Timestamptz(6)

  // --- Signing secret: encrypted, NEVER hashed. ---
  //
  // Verification is base64(HMAC-SHA256(secret, rawBody)), which needs the secret
  // in cleartext at verify time — a hash cannot produce it. AES-256-GCM with AAD
  // bound to (organizationId, id) so a ciphertext copied into another tenant's
  // row fails to decrypt rather than silently verifying their traffic with our
  // secret. Write-only through the API: we never return the value.
  signingSecretEnc   String?   @map("signing_secret_enc")
  signingSecretSetAt DateTime? @map("signing_secret_set_at") @db.Timestamptz(6)
  /// Grace window so rotation does not break live traffic while the customer is
  /// mid-paste into Tally.
  previousSecretEnc        String?   @map("previous_secret_enc")
  previousSecretValidUntil DateTime? @map("previous_secret_valid_until") @db.Timestamptz(6)
  /// Separate from "a secret exists": Tally's signing is optional, so a customer
  /// can configure a secret here and forget to paste it there.
  /// false => verify if present, accept if absent, flag it.
  /// true  => no valid signature, no processing.
  requireSignature   Boolean   @default(false) @map("require_signature")

  externalFormId   String? @map("external_form_id")
  externalFormName String? @map("external_form_name")

  /// "Observe only" while mapping is being configured.
  autoCreateLeads  Boolean  @default(true) @map("auto_create_leads")
  defaultLeadType  LeadType @default(BUYER) @map("default_lead_type")
  defaultAgentId   String?  @map("default_agent_id") @db.Uuid
  /// Consent basis applied when the form has no mapped consent field. Defaults
  /// to PENDING on purpose — the demo's createLead() hardcodes 'granted' for
  /// every lead, which would assert consent we never obtained.
  defaultConsentStatus ConsentStatus @default(PENDING) @map("default_consent_status")

  mappingStatus  MappingStatus @default(UNCONFIGURED) @map("mapping_status")
  /// Bumped on every mapping write, stamped onto each submission, so
  /// "reprocess everything ingested under v2" is one query.
  mappingVersion Int           @default(0) @map("mapping_version")
  /// sha256 of sorted (fieldKey:fieldType) — cheap form-change detection.
  schemaFingerprint String?    @map("schema_fingerprint")

  lastEventAt   DateTime? @map("last_event_at") @db.Timestamptz(6)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(6)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft-disable only. Sources are NEVER hard-deleted: a retired token must
  /// still resolve to an org so "14 deliveries hit a retired URL" can be shown
  /// to the right customer instead of vanishing into a 404 log.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  organization  Organization             @relation(fields: [organizationId], references: [id])
  fields        LeadSourceField[]
  mappings      LeadSourceFieldMapping[]
  webhookEvents WebhookEvent[]
  submissions   LeadSubmission[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("lead_sources")
}

/// OBSERVED form schema — what questions we have actually seen.
///
/// Deliberately separate from LeadSourceFieldMapping, which is INTENT — what a
/// human decided. Collapsing the two makes "seen but undecided" indistinguish-
/// able from "deliberately ignored", and loses the label history that powers the
/// "your form changed" alert.
model LeadSourceField {
  id             String      @id @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  leadSourceId   String      @map("lead_source_id") @db.Uuid
  /// Tally's "question_a4Xb2". Stable across label edits, which is why mappings
  /// key on this and a rename never breaks anything.
  fieldKey       String      @map("field_key")
  label          String
  /// [{label, seenAt}] — renames are informational, not breaking.
  labelHistory   Json        @default("[]") @map("label_history")
  /// String, not enum: Tally adds field types and we should not need a
  /// migration to accept a payload.
  fieldType      String      @map("field_type")
  /// [{id, text}] snapshot for DROPDOWN/MULTIPLE_CHOICE/CHECKBOXES. Required so
  /// the mapping UI can show real option text and value_map can key on it.
  options        Json?
  /// Last few normalized values — powers the mapping UI preview.
  sampleValues   Json        @default("[]") @map("sample_values")
  status         FieldStatus @default(NEW)
  firstSeenAt    DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Consecutive deliveries missing this key. Conditional logic, hidden fields
  /// and skipped optional questions all produce absent fields, so we only call a
  /// field MISSING after a long streak — a customer who gets "you deleted a
  /// question!" every time a respondent skips one stops trusting our alerts.
  missingStreak  Int         @default(0) @map("missing_streak")

  leadSource     LeadSource  @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)

  /// Upsert target on every single delivery — the hottest write in the pipeline.
  @@unique([leadSourceId, fieldKey])
  @@index([leadSourceId, status])
  @@map("lead_source_fields")
}

/// INTENT — how a human decided to route a question into our canonical fields.
model LeadSourceFieldMapping {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  leadSourceId   String        @map("lead_source_id") @db.Uuid
  /// FK-by-value to LeadSourceField.fieldKey, deliberately not a hard FK: a
  /// mapping may legitimately be authored (imported/manual) before the field has
  /// ever been observed live.
  sourceFieldKey String        @map("source_field_key")
  /// Canonical target, e.g. "lead.firstName" | "qualification.timeline".
  /// "__ignore__" is a sentinel rather than NULL because NULLs are never equal
  /// in a unique index, which would permit unlimited duplicate ignore rows.
  targetField    String        @map("target_field")
  transform      Json          @default("{\"kind\":\"passthrough\"}")
  /// Lower wins when two questions feed one target.
  priority       Int           @default(100)
  /// false => a heuristic suggestion awaiting human accept. Suggestions are
  /// never silently applied: a wrong phone mapping means calling the wrong person.
  isActive       Boolean       @default(true) @map("is_active")
  confidence     Float?
  origin         MappingOrigin @default(USER)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  leadSource     LeadSource    @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)

  /// targetField MUST be part of the key: one question fans out to several
  /// targets ("Full name" -> firstName AND lastName; "$500k-$650k" -> budgetMin
  /// AND budgetMax). Constraining on sourceFieldKey alone designs you out of the
  /// two most common real-world mappings.
  @@unique([leadSourceId, sourceFieldKey, targetField])
  @@index([leadSourceId, isActive])
  /// Reverse lookup — "is lead.phone mapped?" drives the completeness validator
  /// and the NEEDS_MAPPING banner. This is why mappings are one row per
  /// (question, target) rather than one row per question with a targets[] array:
  /// the reverse query must be an index lookup, not a jsonb scan.
  @@index([leadSourceId, targetField])
  @@map("lead_source_field_mappings")
}

// ---------------------------------------------------------------------------
// Delivery log — also the queue
// ---------------------------------------------------------------------------

model WebhookEvent {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  leadSourceId   String @map("lead_source_id") @db.Uuid

  /// Tally's eventId, stable across its retry ladder.
  providerEventId      String? @map("provider_event_id")
  /// COALESCE(providerEventId, sha256(rawBody)) — never null.
  dedupeKey            String  @map("dedupe_key")
  /// sha256(rawBody) — detects "same content, new eventId".
  payloadHash          String  @map("payload_hash")
  providerSubmissionId String? @map("provider_submission_id")
  providerFormId       String? @map("provider_form_id")
  eventType            String? @map("event_type")

  /// Source of truth for HMAC re-verification. This column is what makes
  /// quarantine recovery possible: when a customer fixes a wrong signing secret
  /// we re-run the HMAC over these exact bytes and promote what now verifies.
  rawBody         String?   @map("raw_body") @db.Text
  rawBodyPurgedAt DateTime? @map("raw_body_purged_at") @db.Timestamptz(6)
  /// Parsed; jsonb so the mapping UI can query field keys.
  payload         Json?
  /// Allowlisted only — the signature header value is redacted.
  headers         Json?
  contentLength   Int?      @map("content_length")

  signatureState      SignatureState @map("signature_state")
  usedPreviousSecret  Boolean        @default(false) @map("used_previous_secret")

  queueState       QueueState       @default(PENDING) @map("queue_state")
  outcome          DeliveryOutcome?
  /// Short machine code, e.g. "no_phone_or_email".
  outcomeReason    String?          @map("outcome_reason")
  /// [{code, fieldKey, detail}]
  warnings         Json             @default("[]")
  /// Per-field {rawValue, targetField, transformedValue, outcome, error}.
  /// The highest-value field in the whole API: it turns "why is this lead wrong"
  /// from a support ticket into a glance.
  mappingTrace     Json             @default("[]") @map("mapping_trace")
  mappingVersionUsed Int?           @map("mapping_version_used")
  errorMessage     String?          @map("error_message")
  /// sha256(errorClass + top frame) — groups 400 identical failures into one
  /// incident row in the Deliveries UI.
  errorFingerprint String?          @map("error_fingerprint")

  attempts    Int       @default(0)
  maxAttempts Int       @default(6) @map("max_attempts")
  /// Backoff and delayed retry. Also how a PAUSED source holds its backlog
  /// instead of rejecting it.
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(6)

  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  /// payload.createdAt. receivedAt minus this exposes upstream retry lag — i.e.
  /// it makes OUR past outages visible after the fact rather than invisible.
  providerCreatedAt DateTime? @map("provider_created_at") @db.Timestamptz(6)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)
  processingMs      Int?      @map("processing_ms")

  isTest     Boolean @default(false) @map("is_test")
  /// Replay always writes a NEW row and never mutates the original: the record
  /// of what arrived and what we did with it at the time must stay immutable.
  replayOfId String? @map("replay_of_id") @db.Uuid

  leadId String? @map("lead_id") @db.Uuid

  leadSource   LeadSource      @relation(fields: [leadSourceId], references: [id])
  organization Organization    @relation(fields: [organizationId], references: [id])
  submission   LeadSubmission?

  /// THE idempotency constraint — and the replay defense. Tally's signature
  /// covers only the body with no timestamp, so a captured request replays
  /// successfully forever; this unique index is a security control, not just a
  /// correctness nicety. Scoped to leadSourceId because eventId uniqueness is
  /// only guaranteed within a provider account.
  @@unique([leadSourceId, dedupeKey])
  @@index([leadSourceId, receivedAt(sort: Desc)])
  @@index([organizationId, outcome, receivedAt(sort: Desc)])
  @@index([errorFingerprint, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id              String  @id @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  assignedAgentId String? @map("assigned_agent_id") @db.Uuid

  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  email           String?
  /// lower(trim(email)). Deliberately NOT gmail dot-stripping — too clever, and
  /// wrong for every other provider.
  emailNormalized String? @map("email_normalized")
  /// As submitted, for display.
  phone           String?
  phoneE164       String? @map("phone_e164")
  /// false => excluded from SMS/voice targeting in M2. A lead with an
  /// unparseable number is still a lead; it just must never be dialed.
  phoneValid      Boolean @default(false) @map("phone_valid")

  /// 'p:'+phoneE164 | 'e:'+emailNormalized | 'l:'+id. Computed in app code
  /// (the id is known pre-insert). The 'l:' form means anonymous leads never
  /// collide with each other under the unique identity index.
  identityKey     String  @map("identity_key")

  status         LeadStatus      @default(NEW)
  leadType       LeadType        @default(BUYER) @map("lead_type")
  temperature    LeadTemperature @default(COLD)
  score          Int             @default(0)
  scoreBreakdown Json?           @map("score_breakdown")

  preferredLocation  String?  @map("preferred_location")
  preferredLocations String[] @default([]) @map("preferred_locations")
  /// Whole dollars. Int caps at $2.1B, ample for residential.
  budgetMin          Int?     @map("budget_min")
  budgetMax          Int?     @map("budget_max")
  propertyType       String?  @map("property_type")
  bedrooms           Int?
  /// Canonical enums only. The SPA's Lead type carries both flat strings
  /// (timeline: string) and typed enums inside qualification
  /// (timeline: '1_to_3_months'), and its seed data disagrees between them
  /// ('under_30_days' vs '1-3 months'). The DB stores the enum form; the flat
  /// string is a presentation concern.
  timeline           String?
  financingStatus    String?  @map("financing_status")
  preapprovalStatus  Boolean  @default(false) @map("preapproval_status")
  qualification      Json?

  /// Unmapped answers, keyed by slug(label). THE guarantee that no answer a
  /// lead ever gave us is lost, even before mapping is configured.
  customFields   Json @default("{}") @map("custom_fields")
  /// {firstName: {submissionId, sourceId, confidence, at}} — lets a
  /// user-confirmed mapping overwrite a value that came from a low-confidence
  /// heuristic guess.
  fieldProvenance Json @default("{}") @map("field_provenance")

  // --- Compliance. See the merge policy: these are the fields ingestion may
  // --- never downgrade. consentStatus REVOKED is immutable from this path.
  consentStatus    ConsentStatus @default(PENDING) @map("consent_status")
  consentSource    String?       @map("consent_source")
  /// The literal checkbox wording the lead agreed to. A boolean alone is not a
  /// defensible TCPA audit trail.
  consentText      String?       @map("consent_text")
  consentAt        DateTime?     @map("consent_at") @db.Timestamptz(6)
  consentIp        String?       @map("consent_ip")
  dncStatus        Boolean       @default(false) @map("dnc_status")
  dncReason        String?       @map("dnc_reason")
  automationPaused Boolean       @default(false) @map("automation_paused")

  /// Identity conflict, consent conflict, or low-confidence mapping.
  needsReview   Boolean  @default(false) @map("needs_review")
  reviewReasons String[] @default([]) @map("review_reasons")

  submissionCount  Int       @default(1) @map("submission_count")
  firstSourceId    String?   @map("first_source_id") @db.Uuid
  lastSubmissionAt DateTime? @map("last_submission_at") @db.Timestamptz(6)
  lastContactedAt  DateTime? @map("last_contacted_at") @db.Timestamptz(6)
  nextFollowupAt   DateTime? @map("next_followup_at") @db.Timestamptz(6)

  /// Human-authored ONLY. Ingestion writes to customFields and submission
  /// history, never here — appending machine text to the field agents use for
  /// their own notes makes it unusable within a month.
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id])
  assignedAgent Agent?           @relation(fields: [assignedAgentId], references: [id])
  submissions   LeadSubmission[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  /// Non-unique ON PURPOSE. Phone is the sole primary identity; email is only a
  /// soft match. Two unique indexes cannot resolve a submission carrying
  /// (phoneA, emailB) where phoneA belongs to lead 1 and emailB to lead 2 — the
  /// insert just fails on whichever trips first, leaving an unprocessable
  /// delivery with no good answer. Instead we attach to the phone match and flag
  /// IDENTITY_CONFLICT for a human: auto-merging two pre-existing leads is
  /// destructive and irreversible.
  @@index([organizationId, emailNormalized])
  @@index([organizationId, assignedAgentId, status])
  @@index([organizationId, needsReview, updatedAt(sort: Desc)])
  /// Pre-built for the M2 follow-up scheduler; costs nothing now, avoids a
  /// migration under load later.
  @@index([organizationId, nextFollowupAt])
  @@map("leads")
}

/// Append-only record of every form submission. leadId is NULLABLE so a
/// submission we cannot yet identify is still preserved rather than dropped.
model LeadSubmission {
  id             String  @id @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  leadId         String? @map("lead_id") @db.Uuid
  leadSourceId   String  @map("lead_source_id") @db.Uuid
  /// Exactly one submission per delivery — a second idempotency layer beneath
  /// the transport-level dedupeKey.
  webhookEventId String  @unique @map("webhook_event_id") @db.Uuid

  providerSubmissionId String?  @map("provider_submission_id")
  /// Tally's respondentId — a cross-submission identity hint.
  providerRespondentId String?  @map("provider_respondent_id")
  submittedAt          DateTime @map("submitted_at") @db.Timestamptz(6)

  /// EVERY question and answer: {key, label, type, textValues[], scalarText, raw}.
  /// The permanent, mapping-independent record — this is what makes a mapping
  /// fix retroactively repairable.
  normalizedAnswers Json     @map("normalized_answers")
  mappedValues      Json     @default("{}") @map("mapped_values")
  unmappedKeys      String[] @default([]) @map("unmapped_keys")
  /// [{field, from, to, policy}] — the merge audit trail. Between this and
  /// prior submissions, every value a lead ever held is reconstructible, so no
  /// merge is truly destructive.
  appliedChanges    Json     @default("[]") @map("applied_changes")
  /// [{field, incoming, reason}] — e.g. "consent requested but lead previously
  /// opted out". Precisely what you need to produce in a compliance dispute.
  skippedChanges    Json     @default("[]") @map("skipped_changes")
  warnings          Json     @default("[]")
  mappingVersion    Int      @default(0) @map("mapping_version")
  mappingConfidence Float?   @map("mapping_confidence")
  isFirstForLead    Boolean  @default(false) @map("is_first_for_lead")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead         Lead?        @relation(fields: [leadId], references: [id])
  leadSource   LeadSource   @relation(fields: [leadSourceId], references: [id])
  webhookEvent WebhookEvent @relation(fields: [webhookEventId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@index([leadSourceId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("lead_submissions")
}

// ---------------------------------------------------------------------------
// Audit + outbox
// ---------------------------------------------------------------------------

/// Append-only (FR-13.4). Mirrors AuditLog in src/types.ts.
model AuditLog {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  actorType      ActorType @default(SYSTEM) @map("actor_type")
  actorId        String?   @map("actor_id")
  /// e.g. "Webhook: Buyer Intake Form"
  actorLabel     String?   @map("actor_label")
  /// "lead.merged", "consent.blocked", "mapping.updated"
  action         String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id")
  description    String
  metadata       Json      @default("{}")
  requestId      String?   @map("request_id")
  ipAddress      String?   @map("ip_address")
  responseTimeMs Int?      @map("response_time_ms")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  /// "history of THIS lead" — the only audit query the UI actually runs.
  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  /// Compliance export, e.g. "every consent event".
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Transactional outbox. Written in the SAME transaction as the lead write, so
/// "lead created" and "notify downstream" can never disagree.
///
/// Nothing consumes this yet. It exists now so that adding WF-04 (instant SMS),
/// WF-05 (AI voice) and CRM sync in M2/M3 does not require touching the
/// ingestion transaction. availableAt also models delayed work, which is what
/// M2's follow-up sequences need — and unlike a Redis delayed set, it stays
/// queryable by leadId and cancellable with one UPDATE when a lead replies or
/// goes DNC.
model DomainEvent {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  /// "lead.created" | "lead.merged" | "lead.reengaged" | "mapping.needs_review"
  eventType      String    @map("event_type")
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([aggregateType, aggregateId, occurredAt(sort: Desc)])
  @@map("domain_events")
}
