/// Where a lead came from. Leads and their submissions point here.
model LeadSource {
  id               String             @id @default(uuid(7)) @db.Uuid
  orgId            String             @map("organization_id") @db.Uuid
  name             String             @db.VarChar(100)
  code             String             @db.VarChar(50)
  provider         LeadSourceProvider @default(WEBHOOK)
  connectionMethod ConnectionMethod   @default(MANUAL) @map("connection_method")
  isActive         Boolean            @default(true) @map("is_active")
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads        Lead[]
  submissions  LeadSubmission[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("lead_sources")
}
