enum UserSource {
  web
  calendly
  cal

  @@map("user_source")
}

enum BaseStatus {
  active
  inactive

  @@map("base_status")
}

enum LeadStatus {
  new
  contacting
  /// Replied by SMS or talked on a call; no outcome yet.
  engaged
  follow_up
  interested
  appointment_requested
  appointment_booked
  not_interested
  /// Every follow-up step ran and the lead never answered.
  unresponsive
  closed
  invalid

  @@map("lead_status")
}

enum FollowUpReason {
  no_answer
  not_ready
  callback_requested
  needs_time
  other
  appointment_canceled
  no_show

  @@map("follow_up_reason")
}

enum LeadTemperature {
  hot
  warm
  cold

  @@map("lead_temperature")
}

enum ConsentStatus {
  granted
  revoked
  pending

  @@map("consent_status")
}

enum AssignmentType {
  manual
  ai

  @@map("assignment_type")
}

enum ActorType {
  user
  ai
  system
  webhook

  @@map("actor_type")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

enum MessageSender {
  ai
  lead
  user

  @@map("message_sender")
}

enum DeliveryStatus {
  pending
  sent
  delivered
  failed

  @@map("delivery_status")
}

enum CallStatus {
  queued
  ringing
  in_progress
  completed
  no_answer
  failed

  @@map("call_status")
}

/// How a call ended, from the lead's side: what the next step depends on.
enum CallDisposition {
  /// Rang out, or was not picked up.
  no_answer
  busy
  /// Declined by the lead.
  rejected
  voicemail
  /// Picked up and hung up before a conversation (shorter than CONVERSATION_MIN_SECS).
  short
  /// A conversation.
  connected
  failed
  /// The number does not exist.
  invalid_number

  @@map("call_disposition")
}

enum IntegrationProvider {
  telnyx

  @@map("integration_provider")
}

enum IntegrationStatus {
  active
  inactive
  invalid
  revoked

  @@map("integration_status")
}

enum LeadSourceProvider {
  WEBHOOK
  TALLY
  GOOGLE_SHEETS
  FILE_UPLOAD
  TYPEFORM
  HUBSPOT
  /// A custom webhook: any app posts JSON, the owner maps the first payload's fields.
  CUSTOM
  /// One Airtable table, synced in one or both directions.
  AIRTABLE
  /// A Google Form. An Apps Script on the form posts each response to our
  /// webhook; backend polling of forms.responses.list recovers what it missed.
  GOOGLE_FORMS

  @@map("lead_source_provider")
}

enum ConnectionMethod {
  MANUAL
  API
  SYNC
  UPLOAD

  @@map("lead_source_connection_method")
}

enum SequenceStatus {
  active
  inactive
  archived

  @@map("sequence_status")
}

enum SequenceTrigger {
  qualified_hot
  qualified_warm
  qualified_cold
  follow_up_no_answer
  follow_up_not_ready
  follow_up_callback_requested
  follow_up_needs_time
  follow_up_other

  @@map("sequence_trigger")
}

enum EnrollmentStatus {
  active
  paused
  completed
  stopped

  @@map("enrollment_status")
}

enum EnrolledBy {
  auto
  manual
  bulk

  @@map("enrolled_by")
}

enum DuplicateCandidateStatus {
  open
  merged
  dismissed

  @@map("duplicate_candidate_status")
}
