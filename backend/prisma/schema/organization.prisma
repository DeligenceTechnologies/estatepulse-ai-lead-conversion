model Organization {
  id     String     @id @default(uuid(7)) @db.Uuid
  name   String     @db.VarChar(255)
  status BaseStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users               User[]
  roles               Role[]
  settings            OrganizationSetting?
  calendarConnections CalendarConnection[]
  leads               Lead[]
  leadSources         LeadSource[]
  integrations        Integration[]
  ingestEvents        IngestEvent[]
  messages            Message[]
  calls               Call[]
  sequences           Sequence[]
  enrollments         SequenceEnrollment[]
  sheetImportRows     SheetImportRow[]
  crmSyncRuns         CrmSyncRun[]
  auditLogs           AuditLog[]
  outreachBatches     OutreachBatch[]
  leadEvents          LeadEvent[]
  dailySummaryRuns    DailySummaryRun[]

  @@map("organizations")
}

model OrganizationSetting {
  id    String @id @default(uuid(7)) @db.Uuid
  orgId String @unique @map("organization_id") @db.Uuid

  timezone     String @default("Asia/Kolkata") @db.VarChar(100)
  workingHours Json   @default("[{\"dayOfWeek\":0,\"isAvailable\":false,\"startTime\":\"09:00\",\"endTime\":\"18:00\"},{\"dayOfWeek\":1,\"isAvailable\":true,\"startTime\":\"09:00\",\"endTime\":\"18:00\"},{\"dayOfWeek\":2,\"isAvailable\":true,\"startTime\":\"09:00\",\"endTime\":\"18:00\"},{\"dayOfWeek\":3,\"isAvailable\":true,\"startTime\":\"09:00\",\"endTime\":\"18:00\"},{\"dayOfWeek\":4,\"isAvailable\":true,\"startTime\":\"09:00\",\"endTime\":\"18:00\"},{\"dayOfWeek\":5,\"isAvailable\":true,\"startTime\":\"09:00\",\"endTime\":\"18:00\"},{\"dayOfWeek\":6,\"isAvailable\":false,\"startTime\":\"09:00\",\"endTime\":\"18:00\"}]") @map("working_hours")

  defaultRegion         String @default("US") @map("default_region") @db.VarChar(2)
  callRecordingEnabled  Boolean @default(true) @map("call_recording_enabled")
  callRecordingAnnounce Boolean @default(true) @map("call_recording_announce")
  leadHotThreshold      Int     @default(75) @map("lead_hot_threshold")
  leadWarmThreshold     Int     @default(45) @map("lead_warm_threshold")
  /// What each thing a caller says is worth when a call is scored ({ within_30_days, budget_identified, … }); unset means the built-in chart.
  leadScorePoints       Json?   @map("lead_score_points")
  maxConcurrentCalls    Int     @default(5) @map("max_concurrent_calls")
  outreachStrategy      Json?   @map("outreach_strategy")
  inCallBooking         Json?   @map("in_call_booking")
  /// When set, the AI assistant answers a lead's texts (what was linked on Telnyx to do it).
  smsConversation       Json?   @map("sms_conversation")
  /// What an AI call leaves on an answering machine ({ enabled, message }); unset means the default message.
  voicemail             Json?   @map("voicemail")
  /// The AI's call-outcome tools on Telnyx (callback, outcome), as provisioned there.
  callTools             Json?   @map("call_tools")
  /// Of maxConcurrentCalls, kept free for calls outside an outreach batch (new form leads, hot follow-ups).
  reservedCallSlots     Int     @default(1) @map("reserved_call_slots")
  /// The owners' end-of-day summary email.
  dailySummaryEnabled   Boolean @default(true) @map("daily_summary_enabled")
  /// HH:MM in `timezone`. Before noon the email covers the previous day; from noon, the day so far.
  dailySummaryTime      String  @default("23:55") @map("daily_summary_time") @db.VarChar(5)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_settings")
}

/// One row per organization per local day the summary email was claimed for:
/// the unique key is what keeps several instances from sending it twice.
model DailySummaryRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  orgId       String    @map("organization_id") @db.Uuid
  summaryDate DateTime  @map("summary_date") @db.Date
  /// claimed | sent | skipped_empty | no_recipients
  status      String    @db.VarChar(20)
  recipients  Int       @default(0)
  claimedAt   DateTime  @default(now()) @map("claimed_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, summaryDate])
  @@map("daily_summary_runs")
}
