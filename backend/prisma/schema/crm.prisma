/// One full read of a connected CRM (HubSpot today): the first import after
/// connecting, or a later complete re-read, resumable from its cursor.
///
/// The PARTIAL unique index crm_sync_runs_one_active (one queued or running run
/// per lead source) lives only in the migration; Prisma cannot express it.
model CrmSyncRun {
  id           String             @id @default(uuid(7)) @db.Uuid
  orgId        String             @map("organization_id") @db.Uuid
  leadSourceId String             @map("lead_source_id") @db.Uuid
  provider     LeadSourceProvider
  kind         CrmSyncRunKind
  status       CrmSyncRunStatus   @default(queued)
  requestedBy  String?            @map("requested_by") @db.Uuid
  /// The provider's paging cursor after the last page written; NULL = from the start.
  cursor       String?            @db.VarChar(255)
  pages        Int                @default(0)
  fetched      Int                @default(0)
  created      Int                @default(0)
  updated      Int                @default(0)
  unchanged    Int                @default(0)
  linked       Int                @default(0)
  conflicts    Int                @default(0)
  duplicates   Int                @default(0)
  skipped      Int                @default(0)
  failed       Int                @default(0)
  missing      Int                @default(0)
  /// Consecutive transient failures; drives backoff.
  attempts     Int                @default(0)
  availableAt  DateTime           @default(now()) @map("available_at") @db.Timestamptz(6)
  errorCode    String?            @map("error_code") @db.VarChar(50)
  errorMessage String?            @map("error_message") @db.VarChar(500)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt    DateTime?          @map("started_at") @db.Timestamptz(6)
  heartbeatAt  DateTime?          @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt   DateTime?          @map("finished_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadSource   LeadSource   @relation(fields: [leadSourceId], references: [id], onDelete: NoAction)
  requester    User?        @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([orgId, leadSourceId, createdAt(sort: Desc)])
  @@map("crm_sync_runs")
}

enum CrmSyncRunKind {
  initial
  full

  @@map("crm_sync_run_kind")
}

enum CrmSyncRunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("crm_sync_run_status")
}
