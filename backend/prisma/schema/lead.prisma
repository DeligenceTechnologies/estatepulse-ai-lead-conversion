model Lead {
  id           String  @id @default(uuid(7)) @db.Uuid
  orgId        String  @map("organization_id") @db.Uuid
  leadSourceId String? @map("lead_source_id") @db.Uuid

  firstName       String? @map("first_name") @db.VarChar(100)
  lastName        String? @map("last_name") @db.VarChar(100)
  email           String? @db.VarChar(255)
  phone           String? @db.VarChar(50)
  normalizedEmail String? @map("normalized_email") @db.VarChar(255)
  normalizedPhone String? @map("normalized_phone") @db.VarChar(50)
  emailValid      Boolean @default(false) @map("email_valid")
  phoneValid      Boolean @default(false) @map("phone_valid")
  externalLeadId  String? @map("external_lead_id") @db.VarChar(255)
  /// IANA zone the lead source provided or an agent set. Null = worked out from the phone number on every read (common/utils/lead-timezone.ts).
  timezone        String? @db.VarChar(100)

  status         LeadStatus       @default(new)
  followUpReason FollowUpReason?  @map("follow_up_reason")
  /// When the lead asked to be called back; nothing else contacts them before it. Cleared once the callback is done.
  callbackAt     DateTime?        @map("callback_at") @db.Timestamptz(6)
  /// When the lead asked to be texted ("message me in 10 minutes"); nothing else contacts them before it. Cleared if it is cancelled or dropped; kept once sent.
  textBackAt     DateTime?        @map("text_back_at") @db.Timestamptz(6)
  temperature    LeadTemperature? @default(cold)
  score          Decimal?         @db.Decimal(5, 2)
  aiSummary      String?          @map("ai_summary")
  lostReason     String?          @map("lost_reason") @db.VarChar(255)

  buyingIntent         String?   @map("buying_intent") @db.VarChar(100)
  timeline             String?   @db.VarChar(100)
  minBudget            Decimal?  @map("min_budget") @db.Decimal(12, 2)
  maxBudget            Decimal?  @map("max_budget") @db.Decimal(12, 2)
  financingStatus      String?   @map("financing_status") @db.VarChar(100)
  location             String?   @db.VarChar(255)
  bedrooms             Int?
  motivation           String?
  utmSource            String?   @map("utm_source") @db.VarChar(255)
  utmMedium            String?   @map("utm_medium") @db.VarChar(255)
  utmCampaign          String?   @map("utm_campaign") @db.VarChar(255)
  customFields         Json      @default("{}") @map("custom_fields")
  /// Answers to the org's custom qualification questions: key -> { value, at, source, refId? }. Overwritten, never appended.
  qualificationAnswers Json      @default("{}") @map("qualification_answers")
  /// A short note of what the lead said across calls and texts that no question covers. Rewritten after each conversation.
  memorySummary        String?   @map("memory_summary")
  memoryUpdatedAt      DateTime? @map("memory_updated_at") @db.Timestamptz(6)

  consentStatus    ConsentStatus @default(pending) @map("consent_status")
  consentSource    String?       @map("consent_source") @db.VarChar(50)
  consentAt        DateTime?     @map("consent_at") @db.Timestamptz(6)
  dncStatus        Boolean       @default(false) @map("dnc_status")
  automationPaused Boolean       @default(false) @map("automation_paused")
  needsReview      Boolean       @default(false) @map("needs_review")
  reviewReasons    String[]      @default([]) @map("review_reasons")

  assignedToId   String?         @map("assigned_to_id") @db.Uuid
  assignedAt     DateTime?       @map("assigned_at") @db.Timestamptz(6)
  assignmentType AssignmentType? @map("assignment_type")
  /// The agent texting the lead in place of the AI ("Take over" in their Conversations). Until they hand it back, the AI does not answer the lead and no automated step reaches them.
  takenOverById  String?         @map("taken_over_by_id") @db.Uuid
  takenOverAt    DateTime?       @map("taken_over_at") @db.Timestamptz(6)

  firstContactAt   DateTime? @map("first_contact_at") @db.Timestamptz(6)
  firstResponseAt  DateTime? @map("first_response_at") @db.Timestamptz(6)
  lastContactAt    DateTime? @map("last_contact_at") @db.Timestamptz(6)
  submissionCount  Int       @default(1) @map("submission_count")
  lastSubmissionAt DateTime? @map("last_submission_at") @db.Timestamptz(6)

  /// Set when this lead was merged into another (LeadMergeService). A merged lead is kept for undo and history,
  /// but is hidden from every list, lookup and automation: everything about the person lives on mergedInto.
  mergedIntoId String?   @map("merged_into_id") @db.Uuid
  mergedAt     DateTime? @map("merged_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadSource    LeadSource?          @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  assignedTo    User?                @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  takenOverBy   User?                @relation("LeadChatTakeover", fields: [takenOverById], references: [id], onDelete: SetNull)
  messages      Message[]
  calls         Call[]
  enrollments   SequenceEnrollment[]
  meetings      CalendarMeeting[]
  callTransfers CallTransfer[]
  outreachItems OutreachBatchLead[]
  events        LeadEvent[]
  mergedInto    Lead?                @relation("LeadMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedLeads   Lead[]               @relation("LeadMergedInto")
  submissions   LeadSubmission[]
  duplicatesAsA DuplicateCandidate[] @relation("DuplicateLeadA")
  duplicatesAsB DuplicateCandidate[] @relation("DuplicateLeadB")

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, status])
  @@index([orgId, temperature])
  @@index([orgId, normalizedPhone])
  @@index([orgId, normalizedEmail])
  @@index([orgId, assignedToId])
  @@index([leadSourceId])
  @@index([orgId, mergedIntoId])
  @@map("leads")
}

model Message {
  id                String           @id @default(uuid(7)) @db.Uuid
  orgId             String           @map("organization_id") @db.Uuid
  leadId            String           @map("lead_id") @db.Uuid
  direction         MessageDirection
  channel           String           @default("sms") @db.VarChar(20)
  senderType        MessageSender    @map("sender_type")
  senderUserId      String?          @map("sender_user_id") @db.Uuid
  body              String
  providerMessageId String?          @map("provider_message_id") @db.VarChar(255)
  deliveryStatus    DeliveryStatus   @default(pending) @map("delivery_status")
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?        @map("delivered_at") @db.Timestamptz(6)
  failedAt          DateTime?        @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([orgId, leadId, createdAt])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([providerMessageId])
  @@map("messages")
}

model Call {
  id               String           @id @default(uuid(7)) @db.Uuid
  orgId            String           @map("organization_id") @db.Uuid
  leadId           String           @map("lead_id") @db.Uuid
  provider         String           @default("telnyx") @db.VarChar(30)
  providerCallId   String?          @map("provider_call_id") @db.VarChar(255)
  direction        String           @default("outbound") @db.VarChar(10)
  status           CallStatus       @default(queued)
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime?        @map("ended_at") @db.Timestamptz(6)
  durationSeconds  Int?             @map("duration_seconds")
  recordingUrl     String?          @map("recording_url")
  transcript       String?
  aiSummary        String?          @map("ai_summary")
  extractedIntel   Json?            @map("extracted_intel")
  handoffRequested Boolean          @default(false) @map("handoff_requested")
  dncDetected      Boolean          @default(false) @map("dnc_detected")
  /// How the call ended for the lead; set at hangup (or when the dial fails).
  disposition      CallDisposition?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  events       LeadEvent[]

  @@index([orgId, createdAt(sort: Desc)])
  @@index([leadId, createdAt(sort: Desc)])
  @@index([providerCallId])
  @@map("calls")
}

/// A phone that asked not to be contacted. Do-not-contact belongs to the number, not one lead record: every lead
/// with it is do-not-contact, a lead created later with it starts that way, and nothing is texted to it. START by
/// text deletes the row; each lead's lead_events keep the history.
model ContactSuppression {
  orgId           String   @map("organization_id") @db.Uuid
  normalizedPhone String   @map("normalized_phone") @db.VarChar(50)
  /// What decided it: sms_reply, call, sms_chat, agent, backfill.
  source          String   @db.VarChar(30)
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, normalizedPhone])
  @@map("contact_suppressions")
}

/// What the outreach decided about a lead, one row per decision and in order:
/// status moves, steps sent, held or skipped, calls ended, replies received.
model LeadEvent {
  id         String      @id @default(uuid(7)) @db.Uuid
  orgId      String      @map("organization_id") @db.Uuid
  leadId     String      @map("lead_id") @db.Uuid
  type       String      @db.VarChar(50)
  fromStatus LeadStatus? @map("from_status")
  toStatus   LeadStatus? @map("to_status")
  reason     String?
  channel    String?     @db.VarChar(10)
  /// What decided it: strategy, followup, call, scoring, sms_reply, calendar, agent, …
  source     String      @db.VarChar(30)
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  callId     String?     @map("call_id") @db.Uuid
  payload    Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call         Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([orgId, type, createdAt(sort: Desc)])
  @@map("lead_events")
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  orgId      String?   @map("organization_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(100)
  entityType String    @map("entity_type") @db.VarChar(50)
  entityId   String?   @map("entity_id") @db.Uuid
  payload    Json?
  durationMs Int?      @map("duration_ms")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One row per time a person reached the org: every form, webhook, import row or manual entry, including the
/// ones that matched an existing lead and were attached to it instead of creating a new one. The isOriginal row
/// is the source the lead first came from; a merge moves the other lead's rows here too.
model LeadSubmission {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("organization_id") @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  leadSourceId String?  @map("lead_source_id") @db.Uuid
  /// webhook, manual, import, crm, sms, backfill
  channel      String   @db.VarChar(20)
  /// What matched it to an existing lead: phone or email. Null when it created the lead.
  matchedBy    String?  @map("matched_by") @db.VarChar(10)
  isOriginal   Boolean  @default(false) @map("is_original")
  /// The mapped values this submission carried, for the lead's source history.
  values       Json     @default("{}")
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadSource   LeadSource?  @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  @@index([leadId, submittedAt])
  @@index([orgId, leadSourceId])
  @@map("lead_submissions")
}

/// A merge of mergedId into survivorId, with everything needed to undo it: the survivor's fields before, the
/// child rows moved (by table) and the rows dropped or stopped because both leads had one.
model LeadMerge {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("organization_id") @db.Uuid
  survivorId     String    @map("survivor_id") @db.Uuid
  mergedId       String    @map("merged_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  reasons        String[]  @default([])
  survivorBefore Json      @map("survivor_before")
  movedRows      Json      @map("moved_rows")
  removedRows    Json      @default("{}") @map("removed_rows")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  undoneAt       DateTime? @map("undone_at") @db.Timestamptz(6)
  undoneById     String?   @map("undone_by_id") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([survivorId, createdAt(sort: Desc)])
  @@index([mergedId])
  @@map("lead_merges")
}

/// Two leads that look like the same person, waiting for someone to merge or dismiss them.
/// leadAId < leadBId, so a pair has one row and a dismissed pair is never suggested again.
model DuplicateCandidate {
  id           String                   @id @default(uuid(7)) @db.Uuid
  orgId        String                   @map("organization_id") @db.Uuid
  leadAId      String                   @map("lead_a_id") @db.Uuid
  leadBId      String                   @map("lead_b_id") @db.Uuid
  score        Int
  reasons      String[]                 @default([])
  status       DuplicateCandidateStatus @default(open)
  resolvedById String?                  @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?                @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadA        Lead         @relation("DuplicateLeadA", fields: [leadAId], references: [id], onDelete: Cascade)
  leadB        Lead         @relation("DuplicateLeadB", fields: [leadBId], references: [id], onDelete: Cascade)

  @@unique([leadAId, leadBId])
  @@index([orgId, status, score(sort: Desc)])
  @@index([leadBId])
  @@map("duplicate_candidates")
}
