/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model followup_sequences {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String                     @db.Uuid
  name                     String                     @db.VarChar(100)
  code                     String                     @db.VarChar(50)
  description              String?
  /// 'active' | 'inactive' | 'archived' — enforced by followup_sequences_status_check.
  status                   String                     @default("active") @db.VarChar(20)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  /// Superseded by sequence_enroll_triggers and no longer read or written.
  /// Kept until the next migration so a rollback has something to fall back on
  /// — see 20260923000001_sequence_enroll_triggers, which also dropped the
  /// partial unique index that used to give this column its teeth.
  auto_enroll_temperature  String?                    @db.VarChar(10)
  organizations            organizations              @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Which conditions enrol a lead into this sequence automatically. Empty =
  /// manual only. At most one ACTIVE sequence per organization may claim each
  /// condition, enforced by sequence_enroll_triggers_one_per_trigger.
  sequence_enroll_triggers sequence_enroll_triggers[]
  sequence_enrollments     sequence_enrollments[]
  sequence_steps           sequence_steps[]

  @@unique([organization_id, code], map: "followup_sequences_code_unique")
  @@index([organization_id], map: "idx_followup_sequences_organization")
  @@index([organization_id, status], map: "idx_followup_sequences_status")
}

/// A form provider's API credential, held so we can install and later repair the
/// webhook on a customer's form. Deliberately NOT `integrations`, whose
/// `credentials_secret_ref` is modelled as a pointer to an external vault.
model provider_credentials {
  id                  String         @id @db.Uuid
  organization_id     String         @db.Uuid
  provider            String         @db.VarChar(50)
  label               String?        @db.VarChar(255)
  /// AES-256-GCM envelope; AAD binds it to (organization_id, id).
  credential_enc      String
  /// sha256(key) — dedupe only, never a lookup path.
  credential_hash     String         @db.VarChar(64)
  credential_prefix   String         @db.VarChar(32)
  credential_last4    String         @db.VarChar(8)
  external_account_id String?        @db.VarChar(255)
  account_email       String?        @db.VarChar(255)
  account_name        String?        @db.VarChar(255)
  /// ACTIVE | INVALID | REVOKED
  status              String         @default("ACTIVE") @db.VarChar(20)
  last_verified_at    DateTime?      @db.Timestamptz(6)
  last_error_at       DateTime?      @db.Timestamptz(6)
  last_error_code     String?        @db.VarChar(50)
  revoked_at          DateTime?      @db.Timestamptz(6)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  lead_sources        lead_sources[]
  organizations       organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id, provider, status], map: "idx_provider_credentials_org")
}

