  error_fingerprint      String?           @db.VarChar(64)
  /// Allowlisted only; the signature header VALUE is redacted to a boolean.
  headers                Json?
  is_test                Boolean           @default(false)
  lead_id                String?           @db.Uuid
  lead_source_id         String?           @db.Uuid
  locked_at              DateTime?         @db.Timestamptz(6)
  locked_by              String?           @db.VarChar(100)
  /// Per-field {rawValue, targetField, transformedValue, outcome, error}.
  /// Turns "why is this lead wrong" from a support ticket into a glance.
  mapping_trace          Json?
  mapping_version_used   Int?
  max_attempts           Int               @default(6)
  /// PROCESSED | PROCESSED_WITH_WARNINGS | DUPLICATE | NEEDS_MAPPING |
  /// NEEDS_IDENTITY | QUARANTINED_SIGNATURE | INVALID_PAYLOAD | ERROR
  outcome                String?           @db.VarChar(30)
  outcome_reason         String?           @db.VarChar(100)
  /// sha256(raw body) — detects "same content, new event id".
  payload_hash           String?           @db.VarChar(64)
  processing_ms          Int?
