/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lead_sources {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id             String                       @db.Uuid
  name                        String                       @db.VarChar(100)
  code                        String                       @db.VarChar(50)
  /// Stays 'webhook' for API-connected sources too — they are byte-identical on
  /// the ingest path. The distinction lives in `connection_method`.
  source_type                 String                       @db.VarChar(50)
  is_active                   Boolean                      @default(true)
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  /// Soft-disable only. A retired token must still resolve to an org so
  /// "14 deliveries hit a retired URL" reaches the right customer instead of
  /// vanishing into a 404 log.
  archived_at                 DateTime?                    @db.Timestamptz(6)
  /// "Observe only" while mapping is being configured.
  auto_create_leads           Boolean                      @default(true)
  /// Consent basis when the form has no mapped consent field. PENDING on
  /// purpose — the demo's createLead() hardcodes 'granted' for every lead, which
  /// would assert consent we never obtained.
  default_consent_status      String                       @default("pending") @db.VarChar(20)
  default_lead_type           String                       @default("buyer") @db.VarChar(20)
  /// Tally data.formId — detects a customer pointing a different form at the
  /// same URL.
  external_form_id            String?                      @db.VarChar(255)
  external_form_name          String?                      @db.VarChar(255)
  /// Lifecycle for the onboarding UI: awaiting_first_event -> needs_mapping ->
  /// active. Varchar to match this schema's existing convention (no enums).
  ingest_status               String?                      @db.VarChar(30)
  /// AES-256-GCM(token), AAD-bound to (organization_id, id). Exists because
  /// re-displayability is a hard requirement here, unlike an API key: the
  /// customer returns next week to paste the URL into a second form, and a
  /// show-once design would force a rotation that silently breaks whatever form
  /// still points at the old URL.
  ingest_token_enc            String?
  /// sha256(token) — the ONLY lookup path on the ingest hot path: one equality
  /// probe, no scan, no decryption. Storing the token in plaintext would mean a
  /// leaked backup lets an attacker inject fabricated leads into every tenant,
  /// which from M2 onward is real SMS/voice spend and TCPA exposure.
  ingest_token_hash           String?                      @unique @db.VarChar(64)
  /// Non-secret display fragment for logs and support triage, e.g. "whk_live_7F3A".
  ingest_token_prefix         String?                      @db.VarChar(32)
  last_event_at               DateTime?                    @db.Timestamptz(6)
  last_failure_at             DateTime?                    @db.Timestamptz(6)
  last_success_at             DateTime?                    @db.Timestamptz(6)
  mapping_status              String?                      @db.VarChar(30)
  /// Bumped on every mapping write and stamped on each submission, so
  /// "reprocess everything ingested under v2" is one query.
  mapping_version             Int                          @default(0)
  /// Rotation grace window. Without it, the instant a customer clicks Rotate
  /// every submission fails until they finish pasting into Tally.
  previous_secret_enc         String?
  previous_secret_valid_until DateTime?                    @db.Timestamptz(6)
  /// Separate from "a secret exists": Tally's signing is optional, so a customer
  /// can configure a secret here and forget to paste it there.
  /// false => verify if present, accept if absent, flag it.
  /// true  => no valid signature, no processing.
  require_signature           Boolean                      @default(false)
  /// sha256 of sorted (fieldKey:fieldType) — cheap form-change detection.
  schema_fingerprint          String?                      @db.VarChar(64)
  /// AES-256-GCM(secret) — encrypted, NEVER hashed. Verification is
  /// base64(HMAC-SHA256(secret, rawBody)), which needs the cleartext at verify
  /// time; a hash cannot produce it.
  signing_secret_enc          String?
  signing_secret_last4        String?                      @db.VarChar(8)
  signing_secret_set_at       DateTime?                    @db.Timestamptz(6)
  token_rotated_at            DateTime?                    @db.Timestamptz(6)
  /// Which form provider this source belongs to, e.g. 'TALLY'.
  provider                    String                       @default("TALLY") @db.VarChar(50)
  /// MANUAL (customer pasted our URL) | API (we installed the webhook).
  /// Only an API source can be repaired, paused or removed remotely.
  connection_method           String                       @default("MANUAL") @db.VarChar(20)
  provider_credential_id      String?                      @db.Uuid
  /// The provider's own id for the webhook we installed.
  external_webhook_id         String?                      @db.VarChar(255)
  external_workspace_id       String?                      @db.VarChar(255)
  /// PENDING | INSTALLED | DRIFTED | UNINSTALLED | ORPHANED | ERROR
  remote_state                String?                      @db.VarChar(20)
  remote_synced_at            DateTime?                    @db.Timestamptz(6)
  remote_error_code           String?                      @db.VarChar(50)
  remote_error_message        String?
  /// Non-null => mappings built from the form schema that no real delivery has
  /// confirmed yet.
  prebuilt_at                 DateTime?                    @db.Timestamptz(6)
  lead_source_field_mappings  lead_source_field_mappings[]
  lead_source_fields          lead_source_fields[]
  organizations               organizations                @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  provider_credentials        provider_credentials?        @relation(fields: [provider_credential_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lead_submissions            lead_submissions[]
  leads                       leads[]
  webhook_events              webhook_events[]

  @@unique([organization_id, code], map: "lead_sources_code_unique")
  @@index([organization_id], map: "idx_lead_sources_organization")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model leads {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String                 @db.Uuid
  lead_source_id           String?                @db.Uuid
  first_name               String?                @db.VarChar(100)
  last_name                String?                @db.VarChar(100)
  email                    String?                @db.VarChar(255)
  phone                    String?                @db.VarChar(50)
  normalized_email         String?                @db.VarChar(255)
  normalized_phone         String?                @db.VarChar(50)
  status                   String                 @default("new") @db.VarChar(30)
  score                    Decimal?               @db.Decimal(5, 2)
  temperature              String?                @db.VarChar(10)
  buying_intent            String?                @db.VarChar(100)
  timeline                 String?                @db.VarChar(100)
  min_budget               Decimal?               @db.Decimal(12, 2)
  max_budget               Decimal?               @db.Decimal(12, 2)
  financing_status         String?                @db.VarChar(100)
  all_cash                 Boolean?
  location                 String?                @db.VarChar(255)
