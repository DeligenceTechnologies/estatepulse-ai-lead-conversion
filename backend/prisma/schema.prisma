  key_prefix      String        @db.VarChar(32)
  scopes          String[]      @default([])
  last_used_at    DateTime?     @db.Timestamptz(6)
  expires_at      DateTime?     @db.Timestamptz(6)
  revoked_at      DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_api_keys_organization")
}

/// OBSERVED form schema — what questions we have actually seen arrive.
///
/// Deliberately separate from lead_source_field_mappings, which is INTENT (what
/// a human decided). Collapsing the two makes "seen but undecided"
/// indistinguishable from "deliberately ignored", and loses the label history
/// that powers the "your form changed" alert.
model lead_source_fields {
  id              String       @id @db.Uuid
  organization_id String       @db.Uuid
  lead_source_id  String       @db.Uuid
  /// Tally's "question_a4Xb2". Stable across label edits, which is why mappings
  /// key on this and a rename never breaks anything.
  field_key       String       @db.VarChar(255)
  label           String
  /// [{label, seenAt}] — renames are informational, not breaking.
  label_history   Json         @default("[]")
  /// Varchar, not enum: Tally adds field types and we must never reject a real
  /// submission because we have not heard of one yet.
  field_type      String       @db.VarChar(50)
  /// [{id, text}] snapshot for choice fields. Required so the mapping UI can
  /// render real option text — value_map keys on text, not on option UUIDs,
  /// because UUIDs are regenerated when a customer rebuilds a dropdown.
  options         Json?
  /// Last few normalized values, for the mapping UI preview.
  sample_values   Json         @default("[]")
  /// NEW | ACTIVE | MISSING
  status          String       @default("NEW") @db.VarChar(20)
  first_seen_at   DateTime     @default(now()) @db.Timestamptz(6)
  last_seen_at    DateTime     @default(now()) @db.Timestamptz(6)
  /// Consecutive deliveries missing this key. Conditional logic, hidden fields
  /// and skipped optional questions all produce absent fields, so a field is
  /// only called MISSING after a long streak — a customer who gets "you deleted
  /// a question!" every time a respondent skips one stops trusting our alerts.
  missing_streak  Int          @default(0)
  lead_sources    lead_sources @relation(fields: [lead_source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lead_source_id, field_key], map: "lead_source_fields_key_unique")
  @@index([lead_source_id, status], map: "idx_lead_source_fields_status")
  @@index([organization_id], map: "idx_lead_source_fields_org")
}

/// INTENT — how a human decided to route a question into our canonical fields.
model lead_source_field_mappings {
  id               String       @id @db.Uuid
  organization_id  String       @db.Uuid
  lead_source_id   String       @db.Uuid
  /// FK-by-value to lead_source_fields.field_key, deliberately not a hard FK: a
  /// mapping may legitimately be authored (imported or manual) before the field
  /// has ever been observed live.
  source_field_key String       @db.VarChar(255)
  /// Canonical target, e.g. "lead.first_name" | "lead.timeline".
  /// "__ignore__" is a sentinel rather than NULL, because NULLs are never equal
  /// in a unique index and would permit unlimited duplicate ignore rows.
  target_field     String       @db.VarChar(100)
  transform        Json         @default("{\"kind\": \"passthrough\"}")
  /// Lower wins when two questions feed one target.
  priority         Int          @default(100)
  /// false => a heuristic suggestion awaiting human accept. Suggestions are
  /// never silently applied: a wrong phone mapping means calling a stranger.
  is_active        Boolean      @default(true)
  confidence       Float?
  /// HEURISTIC | USER | IMPORTED
  origin           String       @default("USER") @db.VarChar(20)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)
  lead_sources     lead_sources @relation(fields: [lead_source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lead_source_id, source_field_key, target_field], map: "lead_source_field_mappings_unique")
  @@index([lead_source_id, is_active], map: "idx_field_mappings_active")
  @@index([lead_source_id, target_field], map: "idx_field_mappings_target")
}

/// Append-only record of every form submission.
///
/// lead_id is NULLABLE so a submission we cannot yet identify (no phone, no
/// email, or mapping not configured) is still preserved rather than dropped —
/// and stays replayable once the mapping is fixed.
model lead_submissions {
  id                     String         @id @db.Uuid
  organization_id        String         @db.Uuid
  lead_id                String?        @db.Uuid
  lead_source_id         String         @db.Uuid
  /// Exactly one submission per delivery — a second idempotency layer beneath
  /// the transport-level dedupe_key.
  webhook_event_id       String         @unique @db.Uuid
  provider_submission_id String?        @db.VarChar(255)
  /// Tally's respondentId — a cross-submission identity hint.
  provider_respondent_id String?        @db.VarChar(255)
  submitted_at           DateTime       @db.Timestamptz(6)
  /// EVERY question and answer: {key, label, type, textValues[], scalarText, raw}.
  /// The permanent, mapping-independent record — this is what makes a mapping
  /// fix retroactively repairable.
  normalized_answers     Json
  mapped_values          Json           @default("{}")
  unmapped_keys          String[]       @default([])
  /// [{field, from, to, policy}] — the merge audit trail. Between this and prior
  /// submissions, every value a lead ever held is reconstructible, so no merge
  /// is truly destructive.
  applied_changes        Json           @default("[]")
  /// [{field, incoming, reason}] — e.g. "consent requested but lead previously
  /// opted out". Precisely what you must produce in a compliance dispute.
  skipped_changes        Json           @default("[]")
  warnings               Json           @default("[]")
  mapping_version        Int            @default(0)
  mapping_confidence     Float?
  is_first_for_lead      Boolean        @default(false)
  created_at             DateTime       @default(now()) @db.Timestamptz(6)
  leads                  leads?         @relation(fields: [lead_id], references: [id], onUpdate: NoAction)
  lead_sources           lead_sources   @relation(fields: [lead_source_id], references: [id], onUpdate: NoAction)
  webhook_events         webhook_events @relation(fields: [webhook_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lead_id, created_at(sort: Desc)], map: "idx_lead_submissions_lead")
  @@index([lead_source_id, created_at(sort: Desc)], map: "idx_lead_submissions_source")
  @@index([organization_id, created_at(sort: Desc)], map: "idx_lead_submissions_org")
}

/// Transactional outbox. Written in the SAME transaction as the lead write, so
/// "lead created" and "notify downstream" can never disagree.
///
/// Nothing consumes it yet. It exists now so that adding WF-04 (instant SMS),
/// WF-05 (AI voice) and CRM sync does not require touching the ingestion
/// transaction. available_at also models delayed work, which is what follow-up
/// sequences need — and unlike a Redis delayed set it stays queryable by lead
/// and cancellable with one UPDATE when a lead replies or goes DNC.
model domain_events {
  id              String        @id @db.Uuid
  organization_id String        @db.Uuid
  aggregate_type  String        @db.VarChar(50)
  aggregate_id    String        @db.Uuid
  /// "lead.created" | "lead.merged" | "lead.reengaged" | "mapping.needs_review"
  event_type      String        @db.VarChar(100)
  payload         Json
  occurred_at     DateTime      @default(now()) @db.Timestamptz(6)
  available_at    DateTime      @default(now()) @db.Timestamptz(6)
  published_at    DateTime?     @db.Timestamptz(6)
  attempts        Int           @default(0)
  last_error      String?
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([aggregate_type, aggregate_id, occurred_at(sort: Desc)], map: "idx_domain_events_aggregate")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// One condition a sequence enrols on, e.g. "nobody ever answered".
///
/// Two jobs in one table: the row records that the office ticked the box, and
/// `active` records whether that tick is currently in force. Splitting them is
/// what lets a sequence be switched off — releasing its conditions for another
/// sequence to claim — and switched back on with its configuration intact.
model sequence_enroll_triggers {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  sequence_id     String   @db.Uuid
  /// Verbatim from sequence_enroll_triggers_trigger_check; the same list is
  /// mirrored in enrollTriggerSchema. See TRIGGER_LABELS for the wording shown
  /// to a person.
  trigger         String   @db.VarChar(30)
  /// Mirrors followup_sequences.status = 'active', written in the same
  /// transaction. Denormalised on purpose: a partial unique index cannot reach
  /// into another table, and "one sequence per condition among ACTIVE
  /// sequences" is the rule that has to hold.
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organizations      organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  followup_sequences followup_sequences @relation(fields: [sequence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// A sequence lists each condition at most once, in force or not.
  @@unique([sequence_id, trigger], map: "sequence_enroll_triggers_one_per_sequence")
  @@index([sequence_id], map: "idx_sequence_enroll_triggers_sequence")
  /// NOTE: sequence_enroll_triggers_one_per_active_trigger — unique on
  /// (organization_id, trigger) WHERE active — is a PARTIAL unique index and
  /// cannot be expressed here. It lives in the migration and is the real
  /// guarantee that two active sequences never claim the same condition.
}
