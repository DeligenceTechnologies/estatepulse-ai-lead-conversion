generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model agent_availability {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id        String         @db.Uuid
  day_of_week     Int            @db.SmallInt
  start_time      DateTime       @db.Time(6)
  end_time        DateTime       @db.Time(6)
  is_available    Boolean        @default(true)
  organization_id String         @db.Uuid
  agent_profiles  agent_profiles @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([agent_id, day_of_week])
  @@index([organization_id], map: "idx_agent_availability_org")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model agent_profiles {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String                 @db.Uuid
  user_id              String                 @db.Uuid
  display_name         String                 @db.VarChar(255)
  title                String?                @db.VarChar(100)
  status               String                 @default("available") @db.VarChar(30)
  phone                String?                @db.VarChar(50)
  email                String?                @db.VarChar(255)
  timezone             String                 @default("America/Chicago") @db.VarChar(100)
  max_active_leads     Int                    @default(25)
  routing_enabled      Boolean                @default(true)
  round_robin_position Int?
  /// The agent's public Calendly booking page, copied from their membership of
  /// the office's Calendly organization.
  calendly_url         String?
  /// Which Calendly member this agent IS -- the user URI that a synced event's
  /// `event_memberships[].user` is matched against to decide whose booking it
  /// is. Set by the roster sync, which matches on email exactly once. NULL
  /// means this agent has not been linked to a Calendly member yet.
  calendly_user_uri    String?
  /// The same thing for Cal.com: the numeric user id that a booking's
  /// `hosts[].id` is matched against. INTEGER because that is what Cal.com
  /// issues, where Calendly issues a URI.
  ///
  /// At most one of these two is ever set, because at most one calendar
  /// provider is connected at a time -- see calendar_connections_org_one_active.
  cal_user_id          Int?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  agent_availability   agent_availability[]
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_territories    agent_territories[]
  appointments         appointments[]
  calendar_connections calendar_connections[]
  lead_assignments     lead_assignments[]

  @@unique([organization_id, user_id])
  @@index([organization_id], map: "idx_agent_profiles_organization")
  @@index([organization_id, routing_enabled], map: "idx_agent_profiles_routing")
  @@index([organization_id, status], map: "idx_agent_profiles_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model agent_territories {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id        String         @db.Uuid
  territory_name  String         @db.VarChar(255)
  territory_type  String         @default("submarket") @db.VarChar(50)
  priority        Int            @default(1)
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  organization_id String         @db.Uuid
  agent_profiles  agent_profiles @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([agent_id, territory_name])
  @@index([agent_id], map: "idx_agent_territories_agent")
  @@index([territory_name], map: "idx_agent_territories_name")
  @@index([organization_id], map: "idx_agent_territories_org")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointments {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                @db.Uuid
  lead_id                String                @db.Uuid
  agent_id               String                @db.Uuid
  calendar_connection_id String?               @db.Uuid
  provider               String                @db.VarChar(30)
  external_event_id      String?               @db.VarChar(255)
  status                 String                @default("scheduled") @db.VarChar(20)
  start_at               DateTime              @db.Timestamptz(6)
  end_at                 DateTime              @db.Timestamptz(6)
  meeting_url            String?
  notes                  String?
  /// Provider-shaped detail we display but never join on: the provider's own
  /// updated_at (which lets a sync tick skip the per-event invitee request for
  /// an unchanged event), cancel/reschedule URLs, cancellation reason, the
  /// event-type name, and the reschedule chain.
  metadata               Json                  @default("{}")
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  agent_profiles         agent_profiles        @relation(fields: [agent_id], references: [id], onUpdate: NoAction)
  calendar_connections   calendar_connections? @relation(fields: [calendar_connection_id], references: [id], onUpdate: NoAction)
  leads                  leads                 @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations          organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// Sync idempotency, and what lets the reconciler be a single upsert instead
  /// of a find-then-write race between two poll ticks. Not partial: Postgres
  /// treats NULLs as distinct, so hand-created rows (no external_event_id)
  /// never collide -- and a partial index is one Prisma could not model here.
  @@unique([organization_id, provider, external_event_id], map: "appointments_external_event_unique")
  @@index([agent_id], map: "idx_appointments_agent")
  @@index([external_event_id], map: "idx_appointments_external_event")
  @@index([lead_id], map: "idx_appointments_lead")
  @@index([organization_id], map: "idx_appointments_organization")
  @@index([agent_id, start_at], map: "idx_appointments_start")
  @@index([organization_id, status], map: "idx_appointments_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
