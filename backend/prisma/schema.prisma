  @@index([action], map: "idx_audit_logs_action")
  @@index([correlation_id], map: "idx_audit_logs_correlation")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([organization_id], map: "idx_audit_logs_organization")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model calendar_connections {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String          @db.Uuid
  agent_id               String?         @db.Uuid
  provider               String          @db.VarChar(30)
  external_account_id    String?         @db.VarChar(255)
  credentials_secret_ref String?
  status                 String          @default("active") @db.VarChar(20)
  last_synced_at         DateTime?       @db.Timestamptz(6)
  metadata               Json?
  created_at             DateTime        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime        @default(now()) @db.Timestamptz(6)
  appointments           appointments[]
  agent_profiles         agent_profiles? @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations          organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// NOTE: the database also holds `calendar_connections_active_unique`, a
  /// PARTIAL unique index on (agent_id, provider) WHERE status = 'active'.
  /// Prisma cannot express a partial index, so it is invisible here and lives
  /// only in 20260922000001_calendar_sync. It is what guarantees one live
  /// calendar per agent per provider while still allowing the several
  /// 'inactive' rows a reconnect leaves behind. Do not "restore" it as a plain
  /// @@unique -- that would reject every reconnect.
  ///
  /// Since 20260922000002 a calendar connection belongs to the ORGANIZATION,
  /// not an agent: `agent_id` is NULL on those rows, and a second partial
  /// unique index, `calendar_connections_org_one_active`, on
  /// (organization_id) WHERE agent_id IS NULL AND status = 'active' is what
  /// holds "one live office calendar" -- the index above cannot, because
  /// Postgres treats NULL agent_ids as distinct from one another.
  ///
  /// Note that index has NO `provider` in its key, which is deliberate:
  /// Calendly and Cal.com are alternatives, and an office that connects one
  /// switches away from the other. Two live providers would sweep the same
  /// office twice.
  ///
  /// Rows WITH an agent_id are the retired per-agent connections, kept because
  /// appointments.calendar_connection_id still references them.
  @@index([agent_id], map: "idx_calendar_connections_agent")
  @@index([organization_id], map: "idx_calendar_connections_organization")
  @@index([organization_id, status], map: "idx_calendar_connections_status")
}

