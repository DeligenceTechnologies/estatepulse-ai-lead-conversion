# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.

# Supabase Postgres. Single long-lived process, so both point at the DIRECT
# connection (port 5432), NOT the transaction pooler (port 6543).
# DIRECT_URL is required by `prisma db pull` and any migration; the pooler
# breaks introspection and prepared statements.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Minimum 32 bytes. Generate with: openssl rand -base64 48
# The server refuses to boot if this is missing, short, or left as the placeholder.
JWT_SECRET="CHANGE_ME_generate_at_least_32_random_bytes"
JWT_ISSUER="estatepulse"

PORT=4000

# Production only — dev uses the Vite proxy, so this can stay empty locally.
# Comma-separated exact origins. Never "*".
CORS_ORIGINS=""

# --- Lead ingestion service (the NestJS app in server/) ------------------------
# Where the ingestion service listens. The portal talks to it server-side only:
# /api/tally/* is JWT-authed here, then forwarded with the org's x-api-key, so
# that key never reaches the browser. Leave as-is for local development.
TALLY_API_URL=http://localhost:3001

# Public base for the webhook URLs this backend hands out (the tunnel/host that
# Tally and other form providers can actually reach). No trailing slash.
PUBLIC_API_URL=http://localhost:4000

# 32-byte key for encrypting stored provider credentials at rest, as 64 hex
# characters (see backend/src/crypto.ts — any other length is ignored and
# secrets are then stored in plaintext).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Strategy engine (AI calling). Deliberately opt-in: it must be the exact
# string "1", and anything else leaves the lead watcher off, so it never starts
# auto-enrolling leads by accident against a shared dev database.
# STRATEGY_ENGINE=1
ENGINE_POLL_MS=15000
