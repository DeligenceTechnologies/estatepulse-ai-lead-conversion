# EstatePulse backend — copy to backend/.env and fill in the <placeholders>.
#   cp backend/.env.example backend/.env
# The server validates this file at boot (src/common/config/env.validation.ts)
# and refuses to start if a REQUIRED value is missing or malformed.
# Lines left commented out use the default shown.
#
# Generate secrets with Node (works in PowerShell and bash):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"   # JWT secrets
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # INTEGRATION_ENCRYPTION_KEY
# Never commit backend/.env, and never share real values in chat.

# ─── Database & Redis (REQUIRED) ──────────────────────────────────────────────
# Each developer uses their own database on the team Postgres server; ask the
# team lead for the host and password. Then: npx prisma migrate deploy
DATABASE_URL=postgresql://postgres:<password>@<db-host>:5432/estate_<yourname>
DIRECT_URL=postgresql://postgres:<password>@<db-host>:5432/estate_<yourname>
# redis:// or rediss://. Used by the email queue (BullMQ).
REDIS_URL=redis://localhost:6379
# EMAIL_WORKER_ENABLED=true
# EMAIL_WORKER_CONCURRENCY=5
# The call worker dials every queued AI call, within each org's concurrent call
# limit (Call Capacity in AI Settings). Turn it off on an instance that must not dial.
# CALL_WORKER_ENABLED=true
# CALL_WORKER_CONCURRENCY=20
# CALL_SLOT_TTL_MS=1800000   # a call slot is freed after this even if its hang-up never arrives

# ─── Server ───────────────────────────────────────────────────────────────────
# PORT=4000
NODE_ENV=development
# LOG_LEVEL=info            # "debug" also logs every SQL statement
# The browser origins allowed to call the API, comma-separated. Not needed in
# dev (Vite proxies /api), only when the frontend is served from another origin.
CORS_ORIGINS=http://localhost:3000
# Where the frontend lives: used in emails and OAuth callbacks.
APP_URL=http://localhost:3000

# ─── Auth (REQUIRED) ──────────────────────────────────────────────────────────
# At least 32 characters each, and the two must differ.
JWT_ACCESS_SECRET=<random, 32+ characters>
JWT_REFRESH_SECRET=<a different random value, 32+ characters>
# JWT_ACCESS_EXPIRES_IN_SECONDS=900
# REFRESH_TOKEN_EXPIRES_IN_SECONDS=86400
# REFRESH_TOKEN_KEEP_SIGNED_IN_EXPIRES_IN_SECONDS=2592000
# COOKIE_SECURE=false        # defaults to true when NODE_ENV=production

# ─── Mail (optional: without a provider no email is sent) ─────────────────────
# MAIL_PROVIDER=smtp          # smtp | resend
# MAIL_FROM=EstatePulse <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# RESEND_API_KEY=

# ─── Integration secrets ──────────────────────────────────────────────────────
# 32 bytes, base64 (ends with "="). Encrypts stored provider credentials:
# Telnyx, Google, HubSpot, calendars, webhook signing secrets. Without it,
# connecting any of them fails with "Integrations are not configured".
# BACK IT UP: losing it makes every stored credential unreadable.
INTEGRATION_ENCRYPTION_KEY=<base64 of 32 random bytes>

# ─── Public URL for callbacks ─────────────────────────────────────────────────
# The address third parties call back: form webhooks, Telnyx call events and
# AI tool calls. Locally, a tunnel to http://localhost:4000, e.g.
#   cloudflared tunnel --url http://localhost:4000
# (a quick tunnel's URL changes on every restart — update this and restart).
# Without it AI calls connect but the assistant never joins.
PUBLIC_API_URL=https://<your-tunnel>.trycloudflare.com
# ALLOW_INSECURE_INGEST_URL=false   # true lets a form provider use a non-public URL (local testing only)
# INGEST_MAX_BODY_BYTES=1048576

# ─── Lead ingest (form providers) ─────────────────────────────────────────────
# TALLY_API_BASE_URL=https://api.tally.so
# TYPEFORM_API_BASE_URL=https://api.typeform.com
# PROVIDER_HTTP_TIMEOUT_MS=10000
# The worker that turns stored deliveries into leads.
# WORKER_ENABLED=true
# WORKER_POLL_INTERVAL_MS=1000
# WORKER_MAX_POLL_INTERVAL_MS=10000
# WORKER_BATCH_SIZE=10
# WORKER_STUCK_AFTER_MS=300000

# ─── AI outreach ──────────────────────────────────────────────────────────────
# CALLS AND TEXTS REAL PEOPLE. Keep 0 unless you are testing with your own
# phone number and a connected Telnyx account.
STRATEGY_ENGINE=0
# ENGINE_POLL_MS=15000
# STRATEGY_STALE_MS=86400000
# FOLLOWUP_POLL_MS=60000
# FOLLOWUP_BATCH_SIZE=20
# FOLLOWUP_STUCK_AFTER_MS=600000
# "Call now / schedule" for approved imports, paced by each org's call limits.
# Off: approving releases leads at once, as before.
OUTREACH_SCHEDULING_ENABLED=1
# OUTREACH_POLL_MS=15000

# ─── Imports ──────────────────────────────────────────────────────────────────
FILE_IMPORT_ENABLED=1
# FILE_IMPORT_MAX_BYTES=5242880
# Google Sheets needs an OAuth client from Google Cloud console.
GOOGLE_SHEETS_ENABLED=0
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=        # default ${APP_URL}/oauth/google-callback.html — must match the console exactly
# GOOGLE_PICKER_API_KEY=
# GOOGLE_APP_ID=
# SHEETS_SYNC=false            # periodic re-sync of switched-on sheets
# SHEETS_POLL_MS=60000
# SHEETS_SYNC_INTERVAL_MS=300000
# SHEETS_VERSION_PROBE=false
# SHEETS_FULL_READ_MAX_AGE_MS=21600000
# A URL any app can post leads to; the owner maps the fields on screen.
CUSTOM_WEBHOOK_ENABLED=0

# ─── Retell (voice-only calling provider) ─────────────────────────────────────
# Lets an organization call through Retell instead of Telnyx (never both; no SMS).
# Off: every route answers 404 and every organization calls through Telnyx.
# Switch organizations on Retell back to Telnyx before turning this off.
RETELL_ENABLED=0

# ─── HubSpot CRM import ───────────────────────────────────────────────────────
HUBSPOT_ENABLED=0
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=      # also verifies HubSpot webhook signatures
# HUBSPOT_REDIRECT_URI=       # default ${APP_URL}/oauth/hubspot-callback.html
# HUBSPOT_SCOPES=             # default "oauth crm.objects.contacts.read"
# HUBSPOT_WEBHOOK_URL=        # default ${PUBLIC_API_URL}/ingest/v1/crm/hubspot/webhook
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
# HUBSPOT_AUTH_BASE_URL=https://app.hubspot.com
# HUBSPOT_API_VERSION=2026-09
# HUBSPOT_RETRY_BASE_MS=1000
# CRM_POLL_MS=30000
# CRM_RECONCILE_INTERVAL_MS=3600000

# ─── Calendars (Calendly / Cal.com) ───────────────────────────────────────────
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# CALENDLY_REDIRECT_URI=      # must reach GET /org-settings/calendar/calendly/callback on this server
# CALENDLY_SCOPES=
# CALENDAR_WEBHOOK_BASE_URL=  # public https API address; without it availability is polled only
