# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.
#
# One file for the whole backend. It serves two route families from one process
# (see src/app.ts): the portal — auth and AI calling — and the lead-ingestion
# service. Everything below is read at boot; a missing required value is fatal
# rather than a surprise at the first webhook.

# --- Database -----------------------------------------------------------------
# Supabase Postgres. Single long-lived process, so both point at the DIRECT
# connection (port 5432), NOT the transaction pooler (port 6543).
# DIRECT_URL is required by `prisma db pull` and any migration; the pooler
# breaks introspection and prepared statements.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# --- Sessions -----------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
# The server refuses to boot if this is missing, short, or left as the placeholder.
JWT_SECRET="CHANGE_ME_generate_at_least_32_random_bytes"
JWT_ISSUER="estatepulse"

# --- HTTP ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Production only — dev uses the Vite proxy, so this can stay empty locally.
# Comma-separated exact origins. Never "*".
CORS_ORIGINS=""

# Public base for the webhook URLs handed to form providers. This must be a host
# Tally can actually reach from the internet: a localhost URL will be accepted
# by us and then never called. Use a tunnel in development:
#   cloudflared tunnel --url http://localhost:4000
PUBLIC_API_BASE_URL=http://localhost:4000

# Public base for the URLs the portal's own simple lead webhook hands out.
PUBLIC_API_URL=http://localhost:4000

# --- Encryption ---------------------------------------------------------------
# Provider API keys and webhook signing secrets, encrypted at rest (AES-256-GCM).
# A JSON object of keyId -> base64 32-byte key, so a key can be rotated without
# a migration: add a new id, point ENCRYPTION_ACTIVE_KEY_ID at it, and keep the
# old one here until everything written under it has been re-encrypted.
#
# LOSING THIS MAKES EVERY STORED CREDENTIAL UNREADABLE. Back it up.
# Generate a key with: openssl rand -base64 32
ENCRYPTION_KEYS={"k1":"CHANGE_ME_base64_of_32_random_bytes"}
ENCRYPTION_ACTIVE_KEY_ID="k1"

# Separate key used by the portal's Telnyx credential storage, as 64 hex
# characters (see src/crypto.ts — any other length is ignored and secrets are
# then stored in plaintext). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Ingestion worker ---------------------------------------------------------
# Set WORKER_ENABLED=false to accept webhooks without processing them — useful
# when running a second instance that should only serve HTTP.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_STUCK_AFTER_MS=300000

# --- Ingestion limits ---------------------------------------------------------
INGEST_MAX_BODY_BYTES=1048576
INGEST_RATE_LIMIT_PER_MIN=120
INGEST_RATE_LIMIT_BURST=40
QUARANTINE_MAX_PER_HOUR=100
QUARANTINE_MAX_PER_SOURCE=20

# --- AI calling ---------------------------------------------------------------
# Deliberately opt-in: it must be the exact string "1", and anything else leaves
# the lead watcher off, so it never starts auto-enrolling leads by accident
# against a shared development database.
# STRATEGY_ENGINE=1
ENGINE_POLL_MS=15000

# --- Calendar sync (Calendly) -------------------------------------------------
# From a Calendly developer OAuth app (https://developer.calendly.com). Leave
# both blank to run without Calendly: the API still boots and the Integrations
# screen says the integration is not configured.
#
# Register the redirect URI in Calendly EXACTLY as:
#   ${PUBLIC_API_BASE_URL}/api/calendly/oauth/callback
# It points at the API, not the SPA, because the code-for-token exchange needs
# CALENDLY_CLIENT_SECRET and that must never reach a browser.
#
# SCOPES. The app must be approved for all of:
#   users:read  organizations:read  event_types:read  scheduled_events:read
#   webhooks:read  webhooks:write
# organizations:read is the one that makes office-level Calendly work at all:
# without it /organization_memberships 403s and no agent can be matched to a
# Calendly member. Calendly grants NO scopes by default to a new OAuth app, and
# adding one to an existing app requires every connected office to reconnect.
#
# The Calendly account an office connects must be an OWNER or ADMIN of its
# Calendly organization — Calendly answers ?organization=-scoped reads only for
# those two roles, and the connect flow refuses anything else up front.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Override the scopes above, space-separated. Only set this when the app is
# approved for FEWER than the defaults.
#
# Calendly validates `scope` against the app's approved list before showing a
# consent screen, and refuses the whole request on its own page with "The
# requested scope is invalid, unknown, or malformed" — the API never hears
# about it, so nothing appears in our logs. If you see that page, the app is
# missing one of the scopes we asked for: add it in the Calendly developer
# console, or narrow this to match.
#
# Dropping event_types:read costs only the "Bookable pages" list. Dropping
# organizations:read breaks office-level Calendly entirely — no member roster
# means no agent can be linked to a Calendly user, so no booking can be
# attributed to anyone and nothing is stored.
# CALENDLY_SCOPES=users:read organizations:read event_types:read scheduled_events:read webhooks:read webhooks:write

# The FULL redirect URI, pasted into the Calendly app exactly as written here.
# Leave it blank to use ${PUBLIC_API_BASE_URL}/api/calendly/oauth/callback.
#
# Set it in development. PUBLIC_API_BASE_URL has to be a public HTTPS URL for
# Tally's webhook ingest, so it is usually a tunnel — and a cloudflared quick
# tunnel gets a NEW random hostname every restart, which would invalidate the
# redirect URI registered with Calendly each time. A Calendly SANDBOX app
# accepts plain http://localhost, so point this at the local API and leave
# PUBLIC_API_BASE_URL to the tunnel.
#
# Production apps must be HTTPS; sandbox apps may use http://localhost.
# CALENDLY_REDIRECT_URI=http://localhost:4000/api/calendly/oauth/callback

# Where the OAuth popup posts its result back to — the SPA's origin. Must be an
# exact origin: postMessage is never given '*', or any page that opened us could
# read the outcome.
PUBLIC_APP_URL=http://localhost:3000

# Deliberately opt-in, exactly like STRATEGY_ENGINE above: it must be the exact
# string "1". The sync loop writes appointments and moves lead statuses, so it
# must never start doing that by accident against a shared database.
# CALENDAR_SYNC=1
CALENDAR_POLL_MS=300000

# How far either side of now each sweep reads. Calendly has no "changed since"
# filter, so a bounded window is the only honest way to poll it.
CALENDAR_WINDOW_PAST_DAYS=7
CALENDAR_WINDOW_FUTURE_DAYS=90

# Overridable so a fake server can stand in for Calendly in tests, including the
# 403 a free plan returns for webhooks and the invalid_grant a rotated refresh
# token returns.
CALENDLY_API_BASE_URL=https://api.calendly.com
CALENDLY_AUTH_BASE_URL=https://auth.calendly.com

# --- Cal.com -----------------------------------------------------------------
#
# The other scheduling provider, and the cheaper way to start: Cal.com gives a
# shared team roster and round-robin assignment on a plan well below Calendly's.
# An office connects ONE of the two, never both -- connecting either retires the
# other (calendar_connections_org_one_active).
#
# Nothing to register. Where Calendly needs an OAuth app set up on this server
# before anyone can connect it, a Cal.com office pastes an API key it generated
# itself, so the integration is available on every deployment with no operator
# involvement. That is why none of the settings below are required.
#
# The key must belong to an owner or admin of a Cal.com TEAM. A personal account
# has no shared roster and no round robin; a Cal.com ORGANIZATION is a separate
# paid tier served by different endpoints, and the connect flow refuses one with
# a message saying so.
CALCOM_API_BASE_URL=https://api.cal.com/v2

# Where Cal.com's public BOOKING pages live -- deliberately separate from the
# API host. cal.com serves its API from api.cal.com and its booking pages from
# cal.com, and a self-hosted install can put them anywhere, so deriving one from
# the other would eventually produce links that go nowhere.
CALCOM_BOOKING_BASE_URL=https://cal.com

# Cal.com versions its endpoints by DATE. Their team event-types route states:
# "Must be set to 2026-06-12. If not set to this value, the endpoint will
# default to an older version." An older version does not fail -- it answers
# with a different body, which we would misread. Change this only alongside the
# response types in providers/calcom.types.ts.
CALCOM_API_VERSION=2026-06-12
