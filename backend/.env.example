# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.
#
# One file for the whole backend. It serves two route families from one process
# (see src/app.ts): the portal — auth and AI calling — and the lead-ingestion
# service. Everything below is read at boot; a missing required value is fatal
# rather than a surprise at the first webhook.

# --- Database -----------------------------------------------------------------
# Supabase Postgres. Single long-lived process, so both point at the DIRECT
# connection (port 5432), NOT the transaction pooler (port 6543).
# DIRECT_URL is required by `prisma db pull` and any migration; the pooler
# breaks introspection and prepared statements.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# --- Sessions -----------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
# The server refuses to boot if this is missing, short, or left as the placeholder.
JWT_SECRET="CHANGE_ME_generate_at_least_32_random_bytes"
JWT_ISSUER="estatepulse"

# --- HTTP ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Production only — dev uses the Vite proxy, so this can stay empty locally.
# Comma-separated exact origins. Never "*".
CORS_ORIGINS=""

# Public base for the webhook URLs handed to form providers. This must be a host
# Tally can actually reach from the internet: a localhost URL will be accepted
# by us and then never called. Use a tunnel in development:
#   cloudflared tunnel --url http://localhost:4000
PUBLIC_API_BASE_URL=http://localhost:4000

# Public base for the URLs the portal's own simple lead webhook hands out.
PUBLIC_API_URL=http://localhost:4000

# --- Encryption ---------------------------------------------------------------
# Provider API keys and webhook signing secrets, encrypted at rest (AES-256-GCM).
# A JSON object of keyId -> base64 32-byte key, so a key can be rotated without
# a migration: add a new id, point ENCRYPTION_ACTIVE_KEY_ID at it, and keep the
# old one here until everything written under it has been re-encrypted.
#
# LOSING THIS MAKES EVERY STORED CREDENTIAL UNREADABLE. Back it up.
# Generate a key with: openssl rand -base64 32
ENCRYPTION_KEYS={"k1":"CHANGE_ME_base64_of_32_random_bytes"}
ENCRYPTION_ACTIVE_KEY_ID="k1"

# Separate key used by the portal's Telnyx credential storage, as 64 hex
# characters (see src/crypto.ts — any other length is ignored and secrets are
# then stored in plaintext). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Ingestion worker ---------------------------------------------------------
# Set WORKER_ENABLED=false to accept webhooks without processing them — useful
# when running a second instance that should only serve HTTP.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_STUCK_AFTER_MS=300000

# --- Ingestion limits ---------------------------------------------------------
INGEST_MAX_BODY_BYTES=1048576
INGEST_RATE_LIMIT_PER_MIN=120
INGEST_RATE_LIMIT_BURST=40
QUARANTINE_MAX_PER_HOUR=100
QUARANTINE_MAX_PER_SOURCE=20

# --- AI calling ---------------------------------------------------------------
# Deliberately opt-in: it must be the exact string "1", and anything else leaves
# the lead watcher off, so it never starts auto-enrolling leads by accident
# against a shared development database.
# STRATEGY_ENGINE=1
ENGINE_POLL_MS=15000

# How old the engine's claim (leads.first_contact_at) must be before a lead
# still sitting at new|contacted is treated as stranded by a restart and closed
# out into follow-up. The strategy's schedule is in-memory, so a deploy mid-run
# drops it; this sweep is what stops those leads being forgotten. A full day by
# default, because a quiet-hours deferral can legitimately push a last step
# overnight and nothing live must ever be cut short.
STRATEGY_STALE_MS=86400000

# --- Nurture (follow-up sequences) --------------------------------------------
# The database-driven runner that fires warm/cold nurture steps. Gated on the
# same STRATEGY_ENGINE=1 switch above: one flag decides whether this deployment
# may contact real people at all.
#
# Unlike the strategy engine's in-process timers, nothing here lives in memory —
# the queue is sequence_enrollments.next_action_at, so a restart or a deploy
# loses nothing and any number of instances can poll at once.
FOLLOWUP_POLL_MS=60000
FOLLOWUP_BATCH_SIZE=20
# How long a claimed row may sit before another instance assumes the worker that
# took it died, and returns it to the queue.
FOLLOWUP_STUCK_AFTER_MS=600000
# --- Outbound email (optional) ----------------------------------------------
# Used to send a new agent their sign-in details when an owner creates them.
# Leave SMTP_HOST unset and email is disabled: agents are still created, and the
# UI tells the owner to pass the password on themselves.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The From address. Falls back to SMTP_USER when blank.
SMTP_FROM=
# 'true' forces implicit TLS. Port 465 implies it already.
SMTP_SECURE=
# Where the SPA is served, used only for the sign-in link in that email.
APP_BASE_URL=
