# EstatePulse backend — copy to backend/.env and fill in the <placeholders>.
#   cp backend/.env.example backend/.env
# The server validates this file at boot (src/common/config/env.validation.ts)
# and refuses to start if a REQUIRED value is missing or malformed.
# Lines left commented out use the default shown.
#
# Generate secrets with Node (works in PowerShell and bash):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"   # JWT secrets
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # INTEGRATION_ENCRYPTION_KEY
# Never commit backend/.env, and never share real values in chat.

# ─── Database & Redis (REQUIRED) ──────────────────────────────────────────────
# Each developer uses their own database on the team Postgres server; ask the
# team lead for the host and password. Then: npx prisma migrate deploy
DATABASE_URL=postgresql://postgres:<password>@<db-host>:5432/estate_<yourname>
DIRECT_URL=postgresql://postgres:<password>@<db-host>:5432/estate_<yourname>
# redis:// or rediss://. Used by the email queue (BullMQ).
REDIS_URL=redis://localhost:6379
# Key prefix for the queues and call slots. Every environment that shares one
# Redis needs its own (e.g. estatepulse-sunny), or their workers take each
# other's jobs and drop them.
# QUEUE_PREFIX=estatepulse
# EMAIL_WORKER_ENABLED=true
# EMAIL_WORKER_CONCURRENCY=5
# The call worker dials every queued AI call, within each org's concurrent call
# limit (Call Capacity in AI Settings). Turn it off on an instance that must not dial.
# CALL_WORKER_ENABLED=true
# CALL_WORKER_CONCURRENCY=20
# CALL_SLOT_TTL_MS=1800000   # a call slot is freed after this even if its hang-up never arrives

# ─── Server ───────────────────────────────────────────────────────────────────
# PORT=4000
# TRUST_PROXY=              # the reverse proxy in front, as an address, subnet or keyword
                            # ('loopback' for one on this box, '10.0.0.0/8', several comma-separated).
                            # Leave it empty with nothing in front: X-Forwarded-For is then ignored,
                            # so rate limits and session records cannot be spoofed with a header.
                            # Set it wrong and every client counts as one bucket. Not a hop count.
NODE_ENV=development
# LOG_LEVEL=info            # "debug" also logs every SQL statement
# The browser origins allowed to call the API, comma-separated. Not needed in
# dev (Vite proxies /api), only when the frontend is served from another origin.
CORS_ORIGINS=http://localhost:3000
# Where the frontend lives: used in emails and OAuth callbacks.
APP_URL=http://localhost:3000

# ─── Auth (REQUIRED) ──────────────────────────────────────────────────────────
# At least 32 characters each, and the two must differ.
JWT_ACCESS_SECRET=<random, 32+ characters>
JWT_REFRESH_SECRET=<a different random value, 32+ characters>
# JWT_ACCESS_EXPIRES_IN_SECONDS=900
# REFRESH_TOKEN_EXPIRES_IN_SECONDS=86400
# REFRESH_TOKEN_KEEP_SIGNED_IN_EXPIRES_IN_SECONDS=2592000
# COOKIE_SECURE=false        # defaults to true when NODE_ENV=production
# New sign-ups must click the emailed link before they can sign in. Defaults to
# true when NODE_ENV=production. Needs MAIL_PROVIDER and APP_URL (boot fails without).
# EMAIL_VERIFICATION_REQUIRED=false

# ─── Mail (optional: without a provider no email is sent) ─────────────────────
# MAIL_PROVIDER=ses           # smtp | resend | ses
# MAIL_FROM=EstatePulse <no-reply@example.com>   # with ses: a verified SES identity (domain or address)
#
# SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
#
# Resend
# RESEND_API_KEY=
#
# AWS SES (API v2). Before going live:
#   1. Verify the MAIL_FROM domain in SES (Easy DKIM) and publish SPF + DMARC.
#   2. Request production access, or SES only delivers to verified addresses
#      (the server logs a warning at boot while the account is in the sandbox).
#   3. Grant the app's IAM role/user: ses:SendEmail (scoped to the identity's ARN)
#      and ses:GetAccount (boot-time status check only).
#   4. Optional: a configuration set with an SNS/EventBridge destination to
#      track bounces and complaints.
# AWS_SES_REGION=ap-south-1   # the region the identity is verified in
# Leave both unset in production to use the instance/task IAM role.
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_CONFIGURATION_SET=

# ─── Integration secrets ──────────────────────────────────────────────────────
# 32 bytes, base64 (ends with "="). Encrypts stored provider credentials:
# Telnyx and calendars. Without it, connecting them fails.
# BACK IT UP: losing it makes every stored credential unreadable.
INTEGRATION_ENCRYPTION_KEY=<base64 of 32 random bytes>

# ─── Public URL for callbacks ─────────────────────────────────────────────────
# The address third parties call back: Telnyx call events and AI tool calls.
# Locally, a tunnel to http://localhost:4000, e.g.
#   cloudflared tunnel --url http://localhost:4000
# (a quick tunnel's URL changes on every restart — update this and restart).
# Without it AI calls connect but the assistant never joins.
PUBLIC_API_URL=https://<your-tunnel>.trycloudflare.com

# ─── AI outreach ──────────────────────────────────────────────────────────────
# CALLS AND TEXTS REAL PEOPLE. Keep 0 unless you are testing with your own
# phone number and a connected Telnyx account.
STRATEGY_ENGINE=0
# ENGINE_POLL_MS=15000
# STRATEGY_STALE_MS=86400000
# FOLLOWUP_POLL_MS=60000
# FOLLOWUP_BATCH_SIZE=20
# FOLLOWUP_STUCK_AFTER_MS=600000
# "Call now / schedule" for approved leads, paced by each org's call limits.
OUTREACH_SCHEDULING_ENABLED=1
# OUTREACH_POLL_MS=15000

# ─── Daily summary email ──────────────────────────────────────────────────────
# Every organization's owners get the day's leads, calls, texts and meetings.
# Owners turn it on/off and pick the time in Settings (default 23:55, their
# timezone). Needs MAIL_PROVIDER; skipped for a day with no activity at all.
# DAILY_SUMMARY_ENABLED=true
# DAILY_SUMMARY_CATCH_UP_HOURS=6       # a summary missed while the server was down still goes out this long after
# DAILY_SUMMARY_POLL_MS=60000

# ─── Calendars (Calendly / Cal.com) ───────────────────────────────────────────
# CALENDAR_WEBHOOK_BASE_URL=  # public https API address; without it availability is polled only

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
# Test mode first: use the keys from https://dashboard.stripe.com/test/apikeys.
# The key must match STRIPE_MODE (sk_test_ with test, sk_live_ with live) or the
# server refuses to boot. Without a secret key every organization is on the free
# plan and checkout answers "not configured" — no payment is ever faked.
# See docs/STRIPE_SETUP.md.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
# Not used by the backend today (checkout is Stripe-hosted); kept for clients.
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the Dashboard webhook endpoint (whsec_…).
# The endpoint is POST ${PUBLIC_API_URL}/billing/webhook.
STRIPE_WEBHOOK_SECRET=

# One recurring Stripe Price per plan and interval (price_…). Each must match
# src/billing/billing-plans.ts exactly — amount, currency (BILLING_CURRENCY) and
# interval — or checkout for that plan refuses to start. Unset = that plan's
# button says "not available yet".
#   Starter       ₹999 / month     ₹9,999 / year
#   Professional  ₹2,999 / month   ₹29,999 / year
#   Business      ₹5,999 / month   ₹59,999 / year
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
BILLING_CURRENCY=inr

# Where Stripe sends the customer back. Defaults: ${APP_URL}/billing/success,
# ${APP_URL}/billing/cancel and ${APP_URL}/settings?tab=billing.
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=
# A specific Customer Portal configuration (bpc_…); unset = the Dashboard default.
# STRIPE_PORTAL_CONFIGURATION_ID=

# Free trial (days) on an organization's first paid subscription. 0 = none.
BILLING_TRIAL_DAYS=0
# Paid features stay on this many days while a renewal payment is retried.
BILLING_PAST_DUE_GRACE_DAYS=7
# 0 = plan limits and features are computed and logged ("would block") but not
# enforced. Turn on (1) at launch, once existing organizations have a plan.
BILLING_ENFORCEMENT_ENABLED=0
# 1 lets owners end a subscription at once instead of at the period end.
BILLING_ALLOW_IMMEDIATE_CANCEL=0
# Retries failed webhook events and re-reads stale subscriptions every 10 minutes.
BILLING_RECONCILE_ENABLED=1
# STRIPE_AUTOMATIC_TAX=0          # Stripe Tax on checkout (enable Stripe Tax first)
# STRIPE_ALLOW_PROMOTION_CODES=0  # promotion-code box on checkout
