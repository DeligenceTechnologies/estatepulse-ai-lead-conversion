# Frontend (Vite) configuration.
#
# Copy to `.env` and fill in. The backend has its own file at server/.env.

# Where the API lives. The SPA never calls this directly — it calls the relative
# path /api/..., and the Vite dev server proxies to this target.
API_BASE_URL=http://localhost:3001

# Dashboard API key, issued by `cd server && npm run seed`.
#
# NOTE THE MISSING VITE_ PREFIX, and do not add one. Vite inlines every VITE_*
# variable into the public browser bundle, where anyone can read it out of
# devtools or by viewing source. This key can read your whole tenant.
#
# Without the prefix it stays inside the dev-server process and is attached to
# proxied requests server-side, so it never reaches the browser. In production,
# a Netlify edge function / proxy injects it the same way.
API_KEY=
